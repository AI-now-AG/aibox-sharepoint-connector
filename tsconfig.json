{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react",
    "strict": true,
    "types": [
      "./src/env.d.ts",
      "./node_modules/@types/turndown/index.d.ts"
    ],
    "module": "ESNext",
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "$*": [
        "./src/*"
      ]
    }
  }
}