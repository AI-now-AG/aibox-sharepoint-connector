---
import { useTranslations } from "$i18n/utils";
import { ObjectId } from "mongodb";
import SubscriptionLayout from "$layouts/SubscriptionLayout.astro";
import GlobalTagModel from "$data/models/globalTag.model";
import GlobalCategoryModel from "$data/models/globalCategory.model";
import {
  RoutePath,
  type TagItem,
  type CategoryItem,
} from "$types/Subscription";
import Step1 from "./Step1.svelte";
import Step2 from "./Step2.svelte";
import Step3 from "./Step3.svelte";
import Step4 from "./Step4.svelte";

const t = useTranslations();
const user = Astro.locals.user;
const { step } = Astro.params;

let pageTitle = "";
let tags: TagItem[] = [];
let categories: CategoryItem[] = [];

switch (step) {
  case RoutePath.Step1:
    pageTitle = t("subscription.customize-your-aibox");
    break;
  case RoutePath.Step2:
    pageTitle = t("subscription.choose-your-plan");
    break;

  case RoutePath.Step3:
    pageTitle = t("subscription.provide-billing-information");
    break;
  case RoutePath.Step4:
    pageTitle = t("subscription.creating-your-account");
    break;
}

if (step == RoutePath.Step1) {
  const allTags = await GlobalTagModel.list();
  const allCategories = await GlobalCategoryModel.list();

  tags = allTags.map((tag) => {
    return {
      title: tag.title,
      value: tag._id.toString(),
      description: tag.description,
      icon: tag.icon,
      iconColor: tag.iconColor,
      // icon: '👭🏿',
      // description: "Nguyen Thi Truong An lang thang qua campuchia tha mot con tho nhe nhu gio ve nha",
      // icon: "data:image/png;base64,",
      // iconColor: '#003399'
    };
  });

  categories = allCategories.map((category) => {
    return {
      title: category.title,
      value: category._id.toString(),
      tags: category.tags?.map((t: ObjectId) => t.toString()) ?? [],
    };
  });
}

if (Astro.locals.tenant?.is_trial !== true) {
  // return Astro.redirect("/restricted");
}
const defaultLanguage = Astro.locals?.tenant?.default_language || "en";
---

<SubscriptionLayout title={pageTitle}>
  {
    step == RoutePath.Step1 && (
      <Step1 {categories} {tags} {defaultLanguage} client:load />
    )
  }
  {step == RoutePath.Step2 && <Step2 {defaultLanguage} client:load />}
  {
    step == RoutePath.Step3 && (
      <Step3 accountEmail={user?.email} {defaultLanguage} client:load />
    )
  }
  {step == RoutePath.Step4 && <Step4 {user} {defaultLanguage} client:load />}
</SubscriptionLayout>
