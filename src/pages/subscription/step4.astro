---
import { useTranslations } from "$i18n/utils";
import SubscriptionLayout from "$layouts/SubscriptionLayout.astro";
import StepComponent from "./Step4.svelte";

const t = useTranslations();
const user = Astro.locals.user;

if (Astro.locals.tenant.is_trial !== true) {
  return Astro.redirect("/restricted");
}

const defaultLanguage = Astro.locals.tenant.default_language || "en";
---

<SubscriptionLayout title={t("subscription.creating-your-account")}>
  <StepComponent {user} client:load {defaultLanguage} />
</SubscriptionLayout>
