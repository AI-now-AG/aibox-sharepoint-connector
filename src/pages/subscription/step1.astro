---
import SubscriptionLayout from "$layouts/SubscriptionLayout.astro";
import AudioOptions from "$components/subscription/AudioOptions.svelte";
---

<SubscriptionLayout title="Choose Your Plan">
  <div class="max-w-5xl mx-auto">
    <h1 class="font-sanns text-3xl font-bold text-black mb-2">
      Choose your plan
    </h1>
    <p class="text-gray-600 mb-6">
      Choose the plan for your needs, <a href="#" class="text-blue-600"
        >more info see here</a
      >
    </p>

    <!-- Plan Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <!-- Starter Plan -->
      <div class="card bg-white shadow-lg rounded-lg p-6">
        <div class="badge badge-primary mb-4">For Solo Users & Beginners</div>
        <h2 class="text-xl font-semibold">aibox Starter</h2>
        <p class="text-3xl font-bold my-2">
          25 CHF <span class="text-sm font-normal">/ per month</span>
        </p>
        <ul class="list-disc list-inside text-gray-600 space-y-2">
          <li>1 User included</li>
          <li>Additional user CHF 20.-</li>
          <li>Manage your own use case</li>
          <li>No storage if user data</li>
          <li>100 Credits included</li>
        </ul>
      </div>

      <!-- Team Plan -->
      <div class="card bg-white shadow-lg rounded-lg p-6">
        <div class="badge badge-primary mb-4">For Growing Teams</div>
        <h2 class="text-xl font-semibold">aibox Team</h2>
        <p class="text-3xl font-bold my-2">
          149 CHF <span class="text-sm font-normal">/ per month</span>
        </p>
        <ul class="list-disc list-inside text-gray-600 space-y-2">
          <li>15 Users included</li>
          <li>Additional User CHF 15.-</li>
          <li>User Management included</li>
          <li>Option Private LLM (CH/EU)</li>
          <li>400 Credits included</li>
        </ul>
      </div>

      <!-- Pro Plan -->
      <div class="card bg-white shadow-lg rounded-lg p-6">
        <div class="badge badge-primary mb-4">
          For Power Teams & Heavy Usage
        </div>
        <h2 class="text-xl font-semibold">siuor'Roa</h2>
        <p class="text-3xl font-bold my-2">
          249 CHF <span class="text-sm font-normal">/ per month</span>
        </p>
        <ul class="list-disc list-inside text-gray-600 space-y-2">
          <li>30 Users included</li>
          <li>Additional User CHF 10.-</li>
          <li>Premium Support</li>
          <li>Custom Enterprise login</li>
          <li>800 Credits included</li>
        </ul>
      </div>
    </div>

    <!-- Audio to Text Options -->
    <h2 class="text-2xl font-semibold mb-4">Audio to Text Options</h2>
    <p class="text-gray-600 mb-6">
      Choose the plan for your needs, <a href="#" class="text-blue-600"
        >more info see here</a
      >
    </p>
    <AudioOptions client:load />

    <!-- Total Price -->
    <div class="text-right mb-4">
      <p class="text-gray-600">
        Total Price for aibox CHF <span class="font-bold">197.-</span> per month
      </p>
    </div>

    <!-- Next Button -->
    <div class="text-right">
      <button class="btn btn-primary">Next</button>
    </div>
  </div>
</SubscriptionLayout>
