---
import { actions } from "astro:actions";

const { searchParams } = Astro.url;
const tenantId = searchParams.get("tenant_id") ?? "";
const companyName = searchParams.get("company_name") ?? "";
const websiteUrl = searchParams.get("website_url") ?? "";

const hasParams = tenantId && companyName && websiteUrl;

let result: any = null;
let error: any = null;
let durationMs: number | null = null;

if (hasParams) {
  const start = Date.now();
  const response = await Astro.callAction(actions.tenantCreation.generateKb, {
    tenant_id: tenantId,
    company_name: companyName,
    website_url: websiteUrl,
  });
  durationMs = Date.now() - start;
  result = response.data;
  error = response.error;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Test: KB Generation</title>
    <style>
      body { font-family: monospace; padding: 2rem; background: #0f0f0f; color: #e0e0e0; }
      h1 { color: #7dd3fc; margin-bottom: 1rem; }
      form { display: flex; flex-direction: column; gap: .75rem; max-width: 480px; margin-bottom: 2rem; }
      label { display: flex; flex-direction: column; gap: .25rem; font-size: .85rem; color: #94a3b8; }
      input { padding: .5rem .75rem; background: #1e1e1e; border: 1px solid #333; border-radius: 6px; color: #e0e0e0; font-size: .9rem; }
      input:focus { outline: none; border-color: #7dd3fc; }
      button { padding: .6rem 1.2rem; background: #2563eb; border: none; border-radius: 6px; color: #fff; font-size: .9rem; cursor: pointer; align-self: flex-start; }
      button:hover { background: #1d4ed8; }
      .badge { display: inline-block; padding: .2rem .6rem; border-radius: 4px; font-size: .75rem; font-weight: bold; margin-bottom: .5rem; }
      .badge-ok  { background: #14532d; color: #86efac; }
      .badge-err { background: #7f1d1d; color: #fca5a5; }
      .meta { font-size: .8rem; color: #64748b; margin-bottom: 1rem; }
      pre { background: #1e1e1e; border: 1px solid #333; border-radius: 8px; padding: 1.25rem; white-space: pre-wrap; word-break: break-word; font-size: .82rem; line-height: 1.6; max-height: 70vh; overflow-y: auto; }
      .hint { color: #64748b; font-size: .82rem; }
    </style>
  </head>
  <body>
    <h1>🧪 Test: KB Generation</h1>

    <form method="GET">
      <label>
        tenant_id *
        <input name="tenant_id" value={tenantId} placeholder="64f1a2b3c4d5e6f7a8b9c0d1" required />
      </label>
      <label>
        company_name *
        <input name="company_name" value={companyName} placeholder="Acme AG" required />
      </label>
      <label>
        website_url *
        <input name="website_url" value={websiteUrl} placeholder="https://acme.ch" required />
      </label>
      <button type="submit">Run generateKb</button>
    </form>

    {!hasParams && (
      <p class="hint">Fill in all fields and submit to run the action.</p>
    )}

    {hasParams && (
      <div>
        {error ? (
          <span class="badge badge-err">ERROR</span>
        ) : (
          <span class="badge badge-ok">OK</span>
        )}
        <p class="meta">
          tenant_id: <strong>{tenantId}</strong> &nbsp;·&nbsp;
          company: <strong>{companyName}</strong> &nbsp;·&nbsp;
          website: <strong>{websiteUrl}</strong>
          {durationMs !== null && <>&nbsp;·&nbsp; {durationMs} ms</>}
        </p>
        <pre>{JSON.stringify(error ?? result, null, 2)}</pre>
      </div>
    )}
  </body>
</html>
