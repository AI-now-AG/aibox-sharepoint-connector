---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import { transformRawData } from "$utils/transformRawData";
import { Permission } from "$enums/Users";
import { TranscriptionType } from "$types/TranscribeRequest";
import { type TranscriptionCard } from "$types/TranscriptionCard";
import ToggleCard from "$pages/settings/transcription/ToggleCard.svelte";
import { AudioCategory } from "$types/TenantFeature";

const t = useTranslations();

const transcriptionTypes = Astro.locals.tenant?.transcription_types;

const hasSubtitle = [
  AudioCategory.Subtitle,
  AudioCategory.SubtitleJson,
  AudioCategory.SubtitleLarge,
].some((type) => transcriptionTypes?.includes(type));

const cards: TranscriptionCard[] = [];

if (Astro.locals.tenant) {
  const data = transformRawData(Astro.locals.tenant);
  const {
    azure_openai_api_key,
    azure_openai_endpoint,
    azure_openai_instance_name,
    azure_openai_whisper_model,
    azure_openai_chat_model,
    speech_api_key,
    speech_region,
    elevenLabs_api_key,
  } = data || {};
  if (
    azure_openai_api_key &&
    azure_openai_endpoint &&
    azure_openai_instance_name &&
    azure_openai_whisper_model &&
    azure_openai_chat_model
  ) {
    cards.push({
      title: t("tenant.audio-to-text"),
      category: [AudioCategory.AudioToText],
      toggle: transcriptionTypes?.includes(AudioCategory.AudioToText) ?? false,
      type: TranscriptionType.Plaintext,
    });
    cards.push({
      title: t("settings.transcription.subtitles-title"),
      category: [
        AudioCategory.Subtitle,
        AudioCategory.SubtitleJson,
        ...(speech_api_key && speech_region
          ? [AudioCategory.SubtitleLarge]
          : []),
        ...(elevenLabs_api_key ? [AudioCategory.Subtitle11Labs] : []),
      ],
      toggle: hasSubtitle,
      type: TranscriptionType.Subtitles,
    });
  }

  if (speech_api_key && speech_region) {
    cards.push({
      title: t("settings.transcription.largefile-title"),
      category: [AudioCategory.AudioPro],
      toggle: transcriptionTypes?.includes(AudioCategory.AudioPro) ?? false,
      type: TranscriptionType.Largefile,
    });
  }
}
let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div
    class="container max-w-5xl mx-auto p-6 grid grid-cols-3 md:grid-cols-[1fr_max-content] items-center gap-8"
  >
    <h1 class="text-4xl font-bold">
      {t("nav.settings.audio")}
    </h1>
  </div>
  <div class="container max-w-5xl mx-auto p-6 space-y-4 mt-2">
    <h1 class="text-lg font-normal text-base-content/80">
      {t("prompt-library.instructions.all")}
    </h1>
    <div
      class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 justify-center"
    >
      {
        userPermissions.includes(Permission.AdminAll) &&
          cards
            .filter((card) =>
              card.category.some((cat) => transcriptionTypes?.includes(cat))
            )
            .map((card) => (
              <div class={`card bg-base-100 shadow-xl flex flex-col justify-between`}>
                <ToggleCard transcriptionCard={card} client:load />
              </div>
            ))
      }
    </div>
  </div>
</Layout>
