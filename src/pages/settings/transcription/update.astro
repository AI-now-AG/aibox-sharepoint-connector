---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import { Permission } from "$enums/Users";
import { TranscriptionType } from "$types/TranscribeRequest";
import { type TranscriptionCard } from "$types/TranscriptionCard";
import UpdateForm from "$pages/settings/transcription/UpdateForm.svelte";

const t = useTranslations();
const { searchParams } = Astro.url;
const typeParam = searchParams.get("type") as TranscriptionType;

if (!Object.values(TranscriptionType).includes(typeParam)) {
  return Astro.redirect("/404");
}

const transcriptions = Astro.locals.tenant?.transcriptions ?? {};
const userPermissions = Astro.locals.user.permissions;

const transcriptionMap: Partial<Record<TranscriptionType, string>> = {
  [TranscriptionType.Plaintext]: t("tenant.audio-to-text"),
  [TranscriptionType.Summarize]: t("settings.transcription.summarize-title"),
  [TranscriptionType.Subtitles]: t("settings.transcription.subtitles-title"),
  [TranscriptionType.Largefile]: t("settings.transcription.largefile-title"),
  [TranscriptionType.Subtitlesjson]: t(
    "settings.transcription.subtitles-title-json",
  ),
};

const card: TranscriptionCard | undefined = transcriptionMap[typeParam]
  ? {
      title: transcriptionMap[typeParam]!,
      description: transcriptions[typeParam]?.text ?? "",
      toggle: transcriptions[typeParam]?.enabled ?? false,
      type: typeParam,
    }
  : undefined;
---

<Layout>
  <div>
    <UpdateForm
      transcriptionCard={card}
      isEditable={userPermissions.includes(Permission.AdminAll)}
      client:load
    />
  </div>
</Layout>
