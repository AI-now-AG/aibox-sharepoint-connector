---
import Layout from "$layouts/Layout.astro";
import GlobalPromptsForm from "./GlobalPromptsForm.svelte";
import { useTranslations } from "$i18n/utils";
import { actions } from "astro:actions";

const t = useTranslations();

const { data: configuration } = await Astro.callAction(
  actions.configurations.get,
  {},
);
---

<Layout>
  <div class="container max-w-5xl mx-auto p-6 space-y-4">
    <h1 class="text-4xl font-bold">{t("global-prompts.title")}</h1>
    <GlobalPromptsForm
      configurationId={configuration?._id.toString() ?? ""}
      promptRefinementInstruction={configuration?.promptRefinementInstruction ||
        ""}
      promptKbGenerationInstruction={configuration?.promptKbGenerationInstruction ||
        ""}
      selfOnboardingIndustryInstruction={configuration?.selfOnboardingIndustryInstruction ||
        ""}
      client:load
    />
  </div>
</Layout>
