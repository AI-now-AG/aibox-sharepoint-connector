---
import Layout from "$layouts/Layout.astro";
import InstructionForm from "./InstructionForm.svelte";
import { useTranslations } from "$i18n/utils";
import { actions } from "astro:actions";

const t = useTranslations();

const { data } = await Astro.callAction(actions.configurations.get, {});
const configuration = data;
---

<Layout>
  <div class="container max-w-5xl mx-auto p-6 space-y-4">
    <h1 class="text-4xl font-bold">{t("instructions.title")}</h1>
    <InstructionForm
      instructions={configuration?.defaultInstructions ?? []}
      citationInstruction={configuration?.citationInstruction}
      configurationId={configuration?._id.toString() ?? ""}
      client:load
    />
  </div>
</Layout>
