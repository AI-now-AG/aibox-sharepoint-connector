---
import Layout from "$layouts/Layout.astro";
import GlobalApiKeysForm from "./GlobalApiKeysForm.svelte";
import { useTranslations } from "$i18n/utils";
import { actions } from "astro:actions";

const t = useTranslations();

const { data: globalKeys } = await Astro.callAction(
  actions.globalApiKeys.get,
  {},
);
---

<Layout>
  <div class="container max-w-5xl mx-auto p-6 space-y-4">
    <h1 class="text-4xl font-bold">{t("global-api-keys.title")}</h1>
    <p class="text-base-content/60">{t("global-api-keys.description")}</p>
    <GlobalApiKeysForm
      configId={globalKeys?._id ?? ""}
      keys={globalKeys ?? null}
      client:load
    />
  </div>
</Layout>
