---
import Layout from "$layouts/Layout.astro";
import SubscriptionInfo from "./SubscriptionInfo.astro";
import { Permission } from "$types/Users";
import { useTranslations } from "$i18n/utils";

const t = useTranslations();

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div class="container max-w-5xl mx-auto p-6 space-y-4">
    <h1 class="text-4xl font-bold">
      {t("nav.subscription")}
    </h1>
    <div class="mt-5">
      {userPermissions.includes(Permission.AdminAll) && <SubscriptionInfo />}
    </div>
  </div>
</Layout>
