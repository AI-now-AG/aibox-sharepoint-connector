---
import { SubscriptionPackageId, AudioOptionId } from "$types/Subscription";
import SubscriptionModel from "$data/models/subscription.model";
import { useTranslations } from "$i18n/utils";

const t = useTranslations();

const { tenant } = Astro.locals;
const subscription = await SubscriptionModel.findActiveByTenant(tenant._id);
const planName = subscription?.plan_name ?? SubscriptionPackageId.Starter;
const addOns = subscription?.add_ons?.map(
  (addOn: { name: AudioOptionId }) => addOn.name,
);
---

<div role="alert" class="alert alert-info inline-flex">
  <span>
    <Fragment set:html={t("settings.subscription.description")} />
  </span>
</div>

{/* Current subscription */}
<div class="py-10">
  <h3 class="mb-3 text-xl font-bold">
    {t("settings.subscription.current-plan")}
  </h3>

  <!-- Plan name -->
  {planName == SubscriptionPackageId.Starter && <p>Starter CHF 25</p>}
  {planName == SubscriptionPackageId.Teams && <p>Teams CHF 149</p>}
  {planName == SubscriptionPackageId.Pro && <p>Pro CHF 249</p>}

  <!-- Add-Ons list -->
  {
    addOns?.some((name: AudioOptionId) => name == AudioOptionId.AudioBasis) && (
      <p>Audio zu Text Basis CHF 25</p>
    )
  }
  {
    addOns?.some(
      (name: AudioOptionId) => name == AudioOptionId.AudioBasisAddOnSubtitle,
    ) && <p>Add-On Subtitle CHF 25</p>
  }
  {
    addOns?.some(
      (name: AudioOptionId) => name == AudioOptionId.AudioBasisAddOnLarge,
    ) && <p>Add-On Audio XL CHF 15</p>
  }
  {
    addOns?.some(
      (name: AudioOptionId) => name == AudioOptionId.AudioPremium,
    ) && <p>Audio zu Text Premium CHF 65</p>
  }
</div>

{/* Billing */}
<div class="py-10">
  <h3 class="mb-3 text-xl font-bold">{t("settings.subscription.billing")}</h3>
  <p>
    <strong>{t("settings.subscription.billing.name")}: </strong>
    {tenant.name}
  </p>
  <p>
    <strong>{t("settings.subscription.billing.address")}: </strong>
    {tenant.billing_info?.address ?? "-"}
  </p>
  <p>
    <strong>{t("settings.subscription.billing.zipcode")}: </strong>
    {tenant.billing_info?.zip_code ?? "-"}
  </p>
  <p>
    <strong>{t("settings.subscription.billing.location")}: </strong>
    {tenant.billing_info?.location ?? "-"}
  </p>
  <p>
    <strong>{t("settings.subscription.billing.email")}: </strong>
    {tenant.billing_info?.email ?? "-"}
  </p>
</div>
