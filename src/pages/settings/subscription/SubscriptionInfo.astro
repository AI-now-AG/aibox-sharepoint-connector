---
import { SubscriptionPackageId, AudioOptionId } from "$types/Subscription";
import SubscriptionModel from "$data/models/subscription.model";
import { getLanguage, useTranslations } from "$i18n/utils";
import { SubscriptionPackages } from "$subscription-packages.json";

const t = useTranslations();
const lang = getLanguage() as "en" | "de";

const { tenant } = Astro.locals;
const subscription = await SubscriptionModel.findActiveByTenant(tenant._id);
const planName = subscription?.plan_name ?? SubscriptionPackageId.Starter;
const addOns = subscription?.add_ons ?? [];

const { plan, audioOptions } = SubscriptionPackages;
---

<div role="alert" class="alert alert-info inline-flex">
  <span>
    <Fragment set:html={t("settings.subscription.description")} />
  </span>
</div>

{/* Current subscription */}
<div class="flex flex-col space-y-2 py-8">
  <h3 class="mb-3 text-xl font-bold">
    {t("settings.subscription.current-plan")}
  </h3>

  <!-- Plan name -->
  {
    Object.values(plan)
      .filter((plan) => plan.id == planName)
      .map((plan) => {
        return (
          <p>
            {plan?.["name"]?.[lang]} CHF {plan?.["price"]}
          </p>
        );
      })
  }

  <!-- Add-Ons list -->
  {
    addOns?.map((addOnName: AudioOptionId) => {
      return (
        <p>
          {audioOptions?.[addOnName]?.["name"]?.[lang]} CHF{" "}
          {audioOptions?.[addOnName]?.["price"]}
        </p>
      );
    })
  }
</div>

{/* Billing */}
<div class="flex flex-col space-y-2 py-8">
  <h3 class="mb-3 text-xl font-bold">{t("settings.subscription.billing")}</h3>
  <p>
    <strong>{t("subscription.company-name")}: </strong>
    {tenant.billing_info?.company_name ?? "-"}
  </p>
  <p>
    <strong>{t("subscription.street-number")}: </strong>
    {tenant.billing_info?.address ?? "-"}
  </p>
  <p>
    <strong>{t("subscription.zip-code")}: </strong>
    {tenant.billing_info?.zip_code ?? "-"}
  </p>
  <p>
    <strong>{t("subscription.location")}: </strong>
    {tenant.billing_info?.location ?? "-"}
  </p>
  <p>
    <strong>{t("subscription.billing-email")}: </strong>
    {tenant.billing_info?.email ?? "-"}
  </p>
</div>
