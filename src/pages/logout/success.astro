---
import BlankLayout from "$layouts/BlankLayout.astro";
import { useTranslations } from "$i18n/utils";

const locals = Astro.url.searchParams.get("lang") || "de";
const t = useTranslations(locals);
---

<BlankLayout title="Logout success">
  <section class="flex items-center h-full p-16">
    <div
      class="container flex flex-col items-center justify-center px-5 mx-auto my-8"
    >
      <div class="max-w-lg text-center">
        <h1 class="mb-8 text-4xl font-extrabold">{t("user.logout.title")}</h1>
        <p class="mt-4 mb-8">
          {t("user.logout.message")}
        </p>
        <a
          rel="noopener noreferrer"
          href="/"
          class="btn btn-outline btn-primary">{t("user.logout.button")}</a
        >
      </div>
    </div>
  </section>
</BlankLayout>

<script is:inline>
  /* Remove all local storage items */
  document.addEventListener("astro:page-load", function () {
    localStorage.clear();
  });
</script>
