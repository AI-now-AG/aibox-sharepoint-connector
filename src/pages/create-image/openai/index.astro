---
import Layout from "$layouts/Layout.astro";
import ImageGenerator from "./ImageGeneratorOpenAI.svelte";
import auth from "$auth/auth";
import { ApiKeyProvider, TenantFeature } from "$types/TenantFeature";

const tenant = Astro.locals.tenant;
const tenantId = tenant?._id?.toString() ?? "";
let hasPermission = false;

if (
  auth.hasFeatureWithProvider(
    Astro.locals,
    TenantFeature.CreateImage,
    ApiKeyProvider.OpenAI
  )
) {
  hasPermission = true;
}
---

<Layout>
  <ImageGenerator tenantId={tenantId} {hasPermission} client:load />
</Layout>
