---
import BlankLayout from "$layouts/BlankLayout.astro";
import ErrorComponent from "./Error.svelte";

const errorCode = Astro.url.searchParams.get("code");
const errorTitle = Astro.url.searchParams.get("error");
const errorDescription = Astro.url.searchParams.get("error_description");
---

<BlankLayout title="Error">
  <ErrorComponent {errorCode} {errorTitle} {errorDescription} client:load />
</BlankLayout>
