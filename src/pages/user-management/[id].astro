---
import Layout from "$layouts/Layout.astro";
import UserForm from "./UserForm.svelte";
import UserModel from "$data/models/user.model";
import { transformRawData } from "$utils/transformRawData";
import { isSameObjectId } from "$utils/common";

export interface Props {
  id: string;
}
const tenant = Astro.locals.tenant;

const { id } = Astro.params;
console.log("id", id);
if (id === undefined) {
  throw new Error("Id is required");
}

const user = await UserModel.get(id);
if (!user || !isSameObjectId(user.tenant_id, Astro.locals.tenant._id)) {
  return Astro.redirect("/404");
}

const data = transformRawData(user);
---

<Layout>
  <UserForm user={data} tenant={tenant} client:load />
</Layout>
