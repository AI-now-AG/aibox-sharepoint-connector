---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import UserList from "$pages/user-management/UserList.svelte";
import { svgIcons } from "$assets/icons";

const t = useTranslations();

const tenant = Astro.locals.tenant;
const tenantId = tenant?._id?.toString() ?? "";
---

<Layout>
  <div
    class="container max-w-full mx-auto grid grid-cols-1 md:grid-cols-[1fr_max-content] px-14"
  >
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("user.user-management")}
    </h1>

    <a
      href="./user-management/add"
      class="mt-2 lg:mt-8 btn btn-active btn-neutral font-normal grow-0"
    >
      <span set:html={svgIcons.add} />
      {t("user.add-new-user")}
    </a>
  </div>
  <div class="px-8">
    <UserList tenantId={tenantId} client:load />
  </div>
</Layout>
