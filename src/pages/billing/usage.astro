---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import TenantUsageReport from "$components/report/TenantUsageReport.svelte";

const t = useTranslations();
---

<Layout>
  <div class="container max-w-6xl mx-auto grid grid-cols-1 px-14">
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("nav.usage")}
    </h1>
  </div>
  <div class="container max-w-6xl mx-auto grid grid-cols-1 px-14">
    <TenantUsageReport enablePosthogTracking={true} client:load />
  </div>
</Layout>
