---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import SubtitleUpload from "./SubtitleUpload.svelte";

const t = useTranslations();

// Check if the user has Subtitle Studio active (subtitle editor is always available when Subtitle Studio is active)
if (!Astro.locals.tenant?.subtitle_studio_active) {
  return Astro.redirect("/404");
}

// Get URL parameters for file URLs
const srtFile = Astro.url.searchParams.get('srtFile');
const assFile = Astro.url.searchParams.get('assFile');
const audioFile = Astro.url.searchParams.get('audioFile');
const audioName = Astro.url.searchParams.get('audioName');
const hasAudio = Astro.url.searchParams.get('hasAudio') === 'true';
---

<Layout>
  <div class="container max-w-8xl mx-auto px-14">
    <div class="xl:pt-2 2xl:pt-4 flex justify-between items-center">
      <h1 class="text-4xl font-bold">
        {t("settings.transcription.subtitle-editor")}
      </h1>
    </div>
    <!-- <p class="mb-6">{t("subtitle-editor.upload-description")}</p> -->
    
    <SubtitleUpload 
      client:load 
      srtFileUrl={srtFile}
      assFileUrl={assFile}
      audioFileUrl={audioFile}
      audioFileName={audioName}
      hasPreloadedAudio={hasAudio}
    />
  </div>
</Layout>