---
import Layout from "$layouts/Layout.astro";
import auth from "$auth/auth";
import ImageGenerationForm from "./ImageGenerationForm.svelte";
import { ApiKeyProvider, TenantFeature } from "$types/TenantFeature";

const tenantId = Astro.locals.tenant?._id?.toString();

const hasPermission = auth.hasFeatureWithProvider(
  Astro.locals,
  TenantFeature.CreateImage,
  ApiKeyProvider.Gemini
);
if (!hasPermission) {
  return Astro.redirect("/restricted");
}
---

<Layout>
  <div
    class="flex flex-col bg-base-200 h-full content-baseline gap-0 place-items-center"
  >
    <div class="px-16 py-6 w-full h-full">
      <div class="flex flex-col h-full max-w-6xl mx-auto">
        <ImageGenerationForm {tenantId} client:load />
      </div>
    </div>
  </div>
</Layout>
