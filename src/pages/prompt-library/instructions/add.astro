---
// Component
import Layout from "$layouts/Layout.astro";
import InstructionForm from "$pages/prompt-library/instructions/InstructionForm.svelte";
import { Permission } from "$enums/Users";

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <InstructionForm
    isEditable={userPermissions.includes(Permission.AdminAll)}
    client:load
  />
</Layout>
