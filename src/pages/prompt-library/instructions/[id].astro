---
import Layout from "$layouts/Layout.astro";
import InstructionModel from "$data/models/instruction.model";
import InstructionForm from "$pages/prompt-library/instructions/InstructionForm.svelte";
import { Permission } from "$data/models/user.model";

export interface Props {
  id: string;
}

const { id } = Astro.params;

const instruction = id ? await InstructionModel.get(id) : undefined; // TODO: Render 404 if not found

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <!-- <div
    class="container max-w-5xl mx-auto p-6 grid grid-cols-1 md:grid-cols-[1fr_max-content] gap-8"
  > -->
  <div>
    <InstructionForm
      instructionId={id}
      instruction={instruction}
      isEditable={userPermissions.includes(Permission.AdminAll)}
      client:load
    />
  </div>
</Layout>
