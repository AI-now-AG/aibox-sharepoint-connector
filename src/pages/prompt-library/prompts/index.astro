---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import Prompts from "$data/models/prompt.model";

const t = useTranslations(Astro.preferredLocale);

const prompts = await Prompts.list();
---

<Layout>
  <div
    class="container max-w-5xl mx-auto p-6 grid grid-cols-1 md:grid-cols-[1fr_max-content] gap-8"
  >
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("prompt-library.prompts.title")}
    </h1>

    <a
      href="prompts/new"
      class="mt-2 lg:mt-8 btn btn-active btn-neutral font-normal grow-0"
    >
      <svg
        width="13"
        height="12"
        viewBox="0 0 13 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M6.5 1V6M6.5 6V11M6.5 6H11.5M6.5 6L1.5 6"
          stroke="white"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {t("prompt-library.prompts.add")}
    </a>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {
        prompts.map((prompt) => (
          <div class="card bg-base-100 shadow-xl overflow-hidden">
            <div class="card-body">
              <div>
                <span class="rounded border border-base-content/10 px-2">
                  {prompt.category}{" "}
                  {prompt.group && <span set:html={`&rang; ${prompt.group}`} />}
                </span>
              </div>
              <h2 class="card-title">{prompt.title}</h2>
              <p class="text-base-content/80">{prompt.description}</p>
              <div class="card-actions">
                <a
                  href={`prompts/${prompt._id.toString()}`}
                  class="btn btn-primary"
                >
                  View prompt
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
