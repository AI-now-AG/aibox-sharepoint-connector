---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import PromptModel from "$data/models/prompt.model";
import CategoryModel from "$data/models/category.model";
import PromptCard from "$components/PromptCard.svelte";

const t = useTranslations(Astro.preferredLocale);

const promptsCursor = await PromptModel.listByUser(Astro.locals.userId);
const prompts = await promptsCursor.toArray();

const calls = prompts.map(async (prompt) => {
  const category = await CategoryModel.get(prompt.category.toString());

  return category;
});

const categories = await Promise.all(calls);

const categoryAll = await CategoryModel.listByUser(Astro.locals.userId);

const promptsEnriched = prompts.map((prompt) => {
  const category = categories.find(
    (category) => category?._id.toString() === prompt.category.toString(),
  );

  const group = category?.groups.find(
    (g) => g._id.toString() === prompt.group.toString(),
  );

  return {
    ...prompt,
    _id: prompt._id.toString(),
    categoryName: category?.title,
    groupName: group?.title,
  };
});
---

<Layout>
  <div
    class="container max-w-5xl mx-auto p-6 grid grid-cols-1 md:grid-cols-[1fr_max-content] gap-8"
  >
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("prompt-library.prompts.title")}
    </h1>

    <a
      href="prompts/add"
      class="mt-2 lg:mt-8 btn btn-active btn-neutral font-normal grow-0"
    >
      <svg
        width="13"
        height="12"
        viewBox="0 0 13 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M6.5 1V6M6.5 6V11M6.5 6H11.5M6.5 6L1.5 6"
          stroke="white"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {t("prompt-library.prompts.add")}
    </a>
  </div>

  <div class="container max-w-5xl mx-auto px-6">
    <label class="input input-bordered flex items-center gap-2">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16 16"
        fill="currentColor"
        class="h-4 w-4 opacity-70"
      >
        <path
          fill-rule="evenodd"
          d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z"
          clip-rule="evenodd"></path>
      </svg>
      <input
        type="text"
        class="grow"
        placeholder={t("prompt-library.prompts.search")}
      />
    </label>
    <div class="flex justify-start">
      <div class="dropdown">
        <label tabindex="2" class="btn m-1 bg-base-300 font-semibold">
          <svg
            width="18"
            height="17"
            viewBox="0 0 18 17"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M1.5 2C1.5 1.44771 1.94772 1 2.5 1H15.5C16.0523 1 16.5 1.44772 16.5 2V3.91912C16.5 4.18434 16.3946 4.43869 16.2071 4.62623L10.9596 9.87377C10.772 10.0613 10.6667 10.3157 10.6667 10.5809V12.6667L7.33333 16V10.5809C7.33333 10.3157 7.22798 10.0613 7.04044 9.87377L1.79289 4.62623C1.60536 4.43869 1.5 4.18434 1.5 3.91912V2Z"
              stroke="#111827"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {t("prompt-library.prompts.filter")}
          <svg
            width="8"
            height="9"
            viewBox="0 0 8 9"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M6 3.66666L4 5.66666L2 3.66666H6Z"
              fill="#1F2937"
              stroke="#1F2937"
              stroke-width="2"
              stroke-linejoin="round"></path>
          </svg>
        </label>
        <ul
          tabindex="2"
          class="dropdown-content p-2 menu shadow-xl bg-base-100 rounded-box z-10"
        >
          {
            categoryAll.map((category) => (
              <li>
                <h3 class="text-md mt-2 font-bold">{category.title}</h3>
                {category.groups.map((group) => (
                  <label class="flex items-center space-x-2">
                    <input type="checkbox" class="checkbox checkbox-neutral" />
                    <span class="font-normal">{group.title}</span>
                  </label>
                ))}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <PromptCard
    promptsEnriched={promptsEnriched}
    preferredLocale={Astro.preferredLocale}
    client:load
  />
</Layout>
