---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import PromptModel from "$data/models/prompt.model";
import CategoryModel from "$data/models/category.model";
import { type PromptCardItem } from "$components/prompt-interface/PromptItem.svelte";
import { FeaturePermission } from "$types/Users";
import PromptToolbar from "$components/prompt-library/prompts/PromptToolbar.svelte";
import PromptListFilter from "./PromptListFilter.svelte";
import type { CategoryItem } from "$types/CategoryItem";
import { isFeaturePermissionEnabled } from "$utils/permission";

const t = useTranslations();

const prompts = await PromptModel.listByTenant(
  Astro.locals.user.tenant_id
);
const calls = prompts.map(async (prompt) => {
  if (!prompt.category) return null;
  const category = await CategoryModel.get(prompt.category.toString());
  return category;
});

const categoryArray = await CategoryModel.listActiveByTenant(
  Astro.locals.user.tenant_id
);
const categoryListArray: CategoryItem[] = categoryArray.map((category) => {
  const group = category.groups
    ?.filter((group) => {
      return group?.active && group.active == true;
    })
    .map((group) => {
      return {
        checked: false,
        title: group.title,
      };
    });
  return {
    checked: false,
    title: category.title,
    group: group,
  };
});

const categories = await Promise.all(calls);

const promptsEnriched: PromptCardItem[] = prompts.map((prompt) => {
  const category = categories.find(
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    (category: any) => category?._id.toString() === prompt.category?.toString()
  );

  const group = category?.groups.find(
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    (g: any) => g._id?.toString() === prompt.group?.toString()
  );

  const tags = [category?.title, group?.title].filter(Boolean) as string[];
  return {
    title: prompt.title,
    description: prompt.description,
    instruction: prompt.prompt,
    id: prompt._id.toString(),
    group: prompt.group?.toString() ?? "",
    tags,
    model: prompt.model,
  };
});
let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div
    class="container max-w-5xl mx-auto p-6 py-8 grid grid-cols-1 md:grid-cols-[1fr_max-content] gap-8"
  >
    <h1 class="text-4xl font-bold">
      {t("prompt-library.prompts.title")}
    </h1>

    <div class="flex gap-2">
      {
        isFeaturePermissionEnabled(
          FeaturePermission.ImportExportAddAssistantInAssistantLibrary,
          userPermissions
        ) && <PromptToolbar isEditable={true} client:load />
      }
    </div>
  </div>

  <PromptListFilter
    promptsEnriched={promptsEnriched}
    categoryList={categoryListArray}
    isEditable={isFeaturePermissionEnabled(
      FeaturePermission.EditAssistantInAssistantLibrary,
      userPermissions
    )}
    client:load
  />
</Layout>
