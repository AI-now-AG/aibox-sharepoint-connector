---
import Layout from "$layouts/Layout.astro";
import Prompts from "$data/models/prompt.model";
import PromptForm from "$pages/prompt-library/prompts/PromptForm.svelte";
import { Permission } from "$types/Users";
import { isSameObjectId } from "$utils/common";
import { transformRawData } from "$utils/transformRawData";

export interface Props {
  id: string;
}
const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const prompt = await Prompts.get(id || ""); // TODO: Render 404 if not found

if (!prompt || !isSameObjectId(prompt.tenant_id, Astro.locals.tenant._id)) {
  return Astro.redirect("/404");
}

const userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div>
    <PromptForm
      promptId={id}
      prompt={transformRawData(prompt)}
      isEditable={userPermissions.includes(Permission.AdminAll)}
      client:load
    />
  </div>
</Layout>
