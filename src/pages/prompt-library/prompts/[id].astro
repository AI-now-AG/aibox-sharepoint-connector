---
import Layout from "$layouts/Layout.astro";
import Prompts from "$data/models/prompt.model";
import PromptForm from "$pages/prompt-library/prompts/PromptForm.svelte";
import { Permission } from "$data/models/user.model";

export interface Props {
  id: string;
}

const { id } = Astro.params;

const prompt = id ? await Prompts.getAsString(id) : undefined; // TODO: Render 404 if not found
let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div>
    <PromptForm
      promptId={id}
      prompt={prompt}
      isEditable={userPermissions.includes(Permission.AdminAll)}
      client:load
    />
  </div>
</Layout>
