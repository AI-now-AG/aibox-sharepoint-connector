---
import Layout from "$layouts/Layout.astro";
import Prompts from "$data/models/prompt.model";
import PromptForm from "$pages/prompt-library/prompts/PromptForm.svelte";
import { Permission } from "$data/models/user.model";

export interface Props {
  id: string;
}
console.log("---1----");
console.log(Astro.params);
console.log("---2----");
const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const prompt = await Prompts.getAsString(id || ""); // TODO: Render 404 if not found

console.log("---Prompt----");
console.log(prompt);
console.log("---Prompt-End----");
if (prompt === null) {
  throw new Error("Prompt not found");
}

const userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div>
    <PromptForm
      promptId={id}
      prompt={prompt}
      isEditable={userPermissions.includes(Permission.AdminAll)}
      client:load
    />
  </div>
</Layout>
