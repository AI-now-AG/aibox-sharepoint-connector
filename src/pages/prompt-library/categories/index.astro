---
import Layout from "$layouts/Layout.astro";
import { svgIcons } from "$assets/icons";
import { useTranslations } from "$i18n/utils";
import CategoryModel from "$data/models/category.model";
import CategoryList from "$components/prompt-library/categories/CategoryList.svelte";
import { FeaturePermission } from "$types/Users";
import { isFeaturePermissionEnabled } from "$utils/permission";
import type { CategoryItem } from "$types/CategoryAPI";

const t = useTranslations();

const categories = await CategoryModel.listByTenant(
  Astro.locals.user.tenant_id
);

const categoriesEnriched: CategoryItem[] = categories.map((category) => ({
  id: category._id.toString(),
  title: category.title,
  active: category.active,
}));

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div
    class="container max-w-5xl mx-auto p-6 grid grid-cols-1 md:grid-cols-[1fr_max-content] gap-8"
  >
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("prompt-library.categories.title")}
    </h1>

    {
      isFeaturePermissionEnabled(
        FeaturePermission.AddCategoryInCategoryList,
        userPermissions
      ) && (
        <a
          href="categories/add"
          class="mt-2 lg:mt-8 btn btn-outline font-normal grow-0"
        >
          <span set:html={svgIcons.add} />
          {t("prompt-library.categories.add")}
        </a>
      )
    }
  </div>

  <CategoryList items={categoriesEnriched} client:load />
</Layout>
