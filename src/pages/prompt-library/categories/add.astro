---
import Layout from "$layouts/Layout.astro";
import CategoryForm from "$pages/prompt-library/categories/CategoryForm.svelte";
import { FeaturePermission } from "$types/Users";
import { isFeaturePermissionEnabled } from "$utils/permission";

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <CategoryForm
    isEditable={isFeaturePermissionEnabled(
      FeaturePermission.EditCategoryInCategoryForm,
      userPermissions
    )}
    client:load
  />
</Layout>
