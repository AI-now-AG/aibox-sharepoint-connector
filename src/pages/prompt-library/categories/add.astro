---
import Layout from "$layouts/Layout.astro";
import CategoryForm from "$pages/prompt-library/categories/CategoryForm.svelte";
import { Permission } from "$enums/Users";

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <CategoryForm
    isEditable={userPermissions.includes(Permission.AdminAll)}
    client:load
  />
</Layout>
