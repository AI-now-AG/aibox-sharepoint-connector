---
import CategoryModel from "$data/models/category.model";
import { Permission } from "$data/models/user.model";
import Layout from "$layouts/Layout.astro";
import NewCategoryForm from "$pages/prompt-library/categories/NewCategoryForm.svelte";

export interface Props {
  id: string;
}

const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const instruction = await CategoryModel.get(id); // TODO: Render 404 if not found
if (instruction === null) {
  throw new Error("Instruction not found");
}
const formattedInstruction = { ...instruction, ...{ _id: id } };

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div>
    <NewCategoryForm
      categoryId={id}
      category={formattedInstruction}
      isEditable={userPermissions.includes(Permission.AdminAll)}
      client:load
    />
  </div>
</Layout>
