---
import Layout from "$layouts/Layout.astro";
import CategoryModel from "$data/models/category.model";
import { Permission } from "$types/Users";
import CategoryForm from "$pages/prompt-library/categories/CategoryForm.svelte";
import { isSameObjectId } from "$utils/common";

export interface Props {
  id: string;
}

const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const category = await CategoryModel.getConvertedObj(id);
if (!category || !isSameObjectId(category.tenant_id, Astro.locals.tenant._id)) {
  return Astro.redirect("/404");
}

const formattedCategory = { ...category, _id: id };

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div>
    <CategoryForm
      category={formattedCategory}
      isEditable={userPermissions.includes(Permission.AdminAll) ||
        userPermissions.includes(Permission.SuperUserAll)}
      client:load
    />
  </div>
</Layout>
