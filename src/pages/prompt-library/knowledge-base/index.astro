---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import KnowledgeBaseModel from "$data/models/knowledgeBase.model";
import Card, { type CardItem } from "$components/Card.svelte";
import { Permission } from "$enums/Users";

const t = useTranslations();

const knowledgeBaseCursor = await KnowledgeBaseModel.listByTenant(
  Astro.locals.user.tenant_id,
);
const knowledgeBases = await knowledgeBaseCursor.toArray();

const knowledgeBasesEnriched: CardItem[] = knowledgeBases.map(
  (knowledgeBase) => ({
    id: knowledgeBase._id.toString(),
    title: knowledgeBase.title,
    description: knowledgeBase.description,
    instruction: knowledgeBase.knowledge_base,
  }),
);
let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div
    class="container max-w-5xl mx-auto p-6 grid grid-cols-1 md:grid-cols-[1fr_max-content] gap-8"
  >
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("prompt-library.knowledgebase.title")}
    </h1>

    {
      userPermissions.includes(Permission.AdminAll) && (
        <a
          href="knowledge-base/add"
          class="mt-2 lg:mt-8 btn btn-active btn-neutral font-normal grow-0"
        >
          <svg
            width="13"
            height="12"
            viewBox="0 0 13 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M6.5 1V6M6.5 6V11M6.5 6H11.5M6.5 6L1.5 6"
              stroke="white"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {t("prompt-library.knowledgebase.add")}
        </a>
      )
    }
  </div>

  <Card
    title={t("prompt-library.knowledgebase.all")}
    items={knowledgeBasesEnriched}
    type="knowledge-base"
    viewLabel={t("prompt-library.knowledgebase.view")}
    isEditable={userPermissions.includes(Permission.AdminAll)}
    client:load
  />
</Layout>
