---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import { FeaturePermission } from "$types/Users";
import KnowledgeBaseList from "$components/prompt-library/knowledge-base/KnowledgeBaseList.svelte";
import { actions } from "astro:actions";
import { isFeaturePermissionEnabled } from "$utils/permission";

const t = useTranslations();
const tenant = Astro.locals.tenant;
const tenantId = tenant?._id?.toString() ?? "";
let userPermissions = Astro.locals.user.permissions;

const [kbResult, configResult] = await Promise.all([
  Astro.callAction(actions.knowledgeBase.listByTenant, { tenant_id: tenantId }),
  Astro.callAction(actions.configurations.get, {}),
]);

const { data, error } = kbResult;
const promptKbInstruction =
  configResult.data?.promptKbGenerationInstruction ?? "";

let items = [];

if (!error) {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  items = data.map((knowledgeBase: any) => ({
    id: knowledgeBase._id?.toString(),
    title: knowledgeBase?.title,
    description: knowledgeBase.description,
    instruction: knowledgeBase.knowledge_base,
    modifiedAt: knowledgeBase.updated_at,
    modifiedBy: knowledgeBase.modified_by,
  }));
}
---

<Layout>
  <div class="container max-w-5xl mx-auto p-6">
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("prompt-library.knowledgebase.title")}
    </h1>
  </div>

  <KnowledgeBaseList
    isEditable={isFeaturePermissionEnabled(
      FeaturePermission.EditKnowledgeBaseInKnowledgeBaseList,
      userPermissions
    )}
    items={items}
    {tenantId}
    {promptKbInstruction}
    client:load
  />
</Layout>
