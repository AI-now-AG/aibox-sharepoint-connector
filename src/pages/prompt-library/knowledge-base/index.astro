---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import { Permission } from "$types/Users";
import KnowledgeBaseList from "$components/prompt-library/knowledge-base/KnowledgeBaseList.svelte";
import { svgIcons } from "$assets/icons";
import { actions } from "astro:actions";

const t = useTranslations();
const tenant = Astro.locals.tenant;
const tenantId = tenant?._id?.toString() ?? "";
let userPermissions = Astro.locals.user.permissions;

const { data, error } = await Astro.callAction(
  actions.knowledgebase.listByTenant,
  {
    tenant_id: tenantId,
  }
);

let items = [];

if (!error) {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  items = data.map((knowledgeBase: any) => ({
    id: knowledgeBase._id?.toString(),
    title: knowledgeBase?.title,
    description: knowledgeBase.description,
    instruction: knowledgeBase.knowledge_base,
    modifiedAt: knowledgeBase.updated_at,
    modifiedBy: knowledgeBase.modified_by,
  }));
}
---

<Layout>
  <div
    class="container max-w-5xl mx-auto p-6 grid grid-cols-1 md:grid-cols-[1fr_max-content] gap-8"
  >
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("prompt-library.knowledgebase.title")}
    </h1>

    {
      userPermissions.includes(Permission.AdminAll) && items.length > 0 && (
        <a
          href="/prompt-library/knowledge-base/add"
          class="mt-2 lg:mt-8 btn btn-outline font-normal grow-0"
        >
          <span set:html={svgIcons.add} />
          {t("prompt-library.knowledgebase.add")}
        </a>
      )
    }
  </div>

  <KnowledgeBaseList
    isEditable={userPermissions.includes(Permission.AdminAll)}
    items={items}
    client:load
  />
</Layout>
