---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import { Permission } from "$enums/Users";
import KnowledgeBaseList from "$components/prompt-interface/KnowledgeBaseList.svelte";
import { svgIcons } from "$assets/icons";

const t = useTranslations();
const tenant = Astro.locals.tenant;
const tenantId = tenant?._id?.toString() ?? "";
let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div
    class="container max-w-5xl mx-auto p-6 grid grid-cols-1 md:grid-cols-[1fr_max-content] gap-8"
  >
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("prompt-library.knowledgebase.title")}
    </h1>

    {
      userPermissions.includes(Permission.AdminAll) && (
        <a
          href="/prompt-library/knowledge-base/add"
          class="mt-2 lg:mt-8 btn btn-active btn-neutral font-normal grow-0"
        >
          <span set:html={svgIcons.add} />
          {t("prompt-library.knowledgebase.add")}
        </a>
      )
    }
  </div>

  <KnowledgeBaseList
    isEditable={userPermissions.includes(Permission.AdminAll)}
    tenantId={tenantId}
    client:load
  />
</Layout>
