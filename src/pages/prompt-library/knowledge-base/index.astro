---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import KnowledgeBaseModel from "$data/models/knowledgeBase.model";
import Card, { type CardItem } from "$components/Card.svelte";

const t = useTranslations(Astro.preferredLocale);

const knowledgeBaseCursor = await KnowledgeBaseModel.listByUser(
  Astro.locals.userId,
);
const knowledgeBases = await knowledgeBaseCursor.toArray();

const knowledgeBasesEnriched: CardItem[] = knowledgeBases.map(
  (knowledgeBase) => ({
    id: knowledgeBase._id.toString(),
    title: knowledgeBase.title,
    description: knowledgeBase.description,
  }),
);
---

<Layout>
  <div
    class="container max-w-5xl mx-auto p-6 grid grid-cols-1 md:grid-cols-[1fr_max-content] gap-8"
  >
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("prompt-library.knowledgebase.title")}
    </h1>

    <a
      href="knowledge-base/add"
      class="mt-2 lg:mt-8 btn btn-active btn-neutral font-normal grow-0"
    >
      <svg
        width="13"
        height="12"
        viewBox="0 0 13 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M6.5 1V6M6.5 6V11M6.5 6H11.5M6.5 6L1.5 6"
          stroke="white"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {t("prompt-library.knowledgebase.add")}
    </a>
  </div>

  <div class="container max-w-5xl mx-auto px-6">
    <label class="input input-bordered flex items-center gap-2">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16 16"
        fill="currentColor"
        class="h-4 w-4 opacity-70"
      >
        <path
          fill-rule="evenodd"
          d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z"
          clip-rule="evenodd"></path>
      </svg>
      <input
        type="text"
        class="grow"
        placeholder={t("prompt-library.prompts.search")}
      />
    </label>
  </div>

  <Card
    title={t("prompt-library.knowledgebase.all")}
    items={knowledgeBasesEnriched}
    type="knowledge-base"
    viewLabel={t("prompt-library.knowledgebase.view")}
    client:load
  />
</Layout>
