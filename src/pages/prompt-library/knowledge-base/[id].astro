---
import Layout from "$layouts/Layout.astro";
import KnowledgeBaseModel from "$data/models/knowledgeBase.model";
import { FeaturePermission } from "$types/Users";
import KnowledgeBaseForm from "$components/prompt-library/knowledge-base/KnowledgeBaseForm.svelte";
import { isSameObjectId } from "$utils/common";
import { isFeaturePermissionEnabled } from "$utils/permission";

export interface Props {
  id: string;
}

const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const knowledgeBase = await KnowledgeBaseModel.get(id || "");
if (
  !knowledgeBase ||
  !isSameObjectId(knowledgeBase.tenant_id, Astro.locals.tenant._id)
) {
  return Astro.redirect("/404");
}

let userPermissions = Astro.locals.user.permissions;
const mode = Astro.url?.searchParams?.get?.("mode") ?? "update";
---

<Layout>
  <div>
    <KnowledgeBaseForm
      knowledgeBaseId={id}
      knowledgeBase={knowledgeBase}
      isEditable={isFeaturePermissionEnabled(
        FeaturePermission.EditKnowledgeBaseInKnowledgeBaseForm,
        userPermissions
      )}
      mode={mode}
      client:load
    />
  </div>
</Layout>
