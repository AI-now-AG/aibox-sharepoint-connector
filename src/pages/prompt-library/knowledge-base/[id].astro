---
import Layout from "$layouts/Layout.astro";
import KnowledgeBaseModel from "$data/models/knowledgeBase.model";
import KnowledgeBaseForm from "$pages/prompt-library/knowledge-base/KnowledgeBaseForm.svelte";
import { Permission } from "$data/models/user.model";

export interface Props {
  id: string;
}

const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const knowledgeBase = await KnowledgeBaseModel.get(id || ""); // TODO: Render 404 if not found
if (knowledgeBase === null) {
  throw new Error("KnowledgeBase not found");
}

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div>
    <KnowledgeBaseForm
      knowledgeBaseId={id}
      knowledgeBase={knowledgeBase}
      isEditable={userPermissions.includes(Permission.AdminAll)}
      client:load
    />
  </div>
</Layout>
