---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import KnowledgeBaseModel from "$data/models/knowledgeBase.model";

export interface Props {
  id: string;
}

const t = useTranslations(Astro.preferredLocale);

const { id } = Astro.params;

const knowledgeBase = id ? await KnowledgeBaseModel.get(id) : undefined; // TODO: Render 404 if not found
---

<Layout>
  <div
    class="container max-w-5xl mx-auto p-6 grid grid-cols-1 md:grid-cols-[1fr_max-content] gap-8"
  >
    {
      knowledgeBase && (
        <h1 class="pt-2 lg:pt-8 text-4xl font-bold">{knowledgeBase.title}</h1>
      )
    }
  </div>
</Layout>
