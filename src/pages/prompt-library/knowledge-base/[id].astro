---
import Layout from "$layouts/Layout.astro";
import KnowledgeBaseModel from "$data/models/knowledgeBase.model";
import KnowledgeBaseForm from "$pages/prompt-library/knowledge-base/KnowledgeBaseForm.svelte";
import { Permission } from "$enums/Users";
import { ObjectId } from "mongodb";

export interface Props {
  id: string;
}

const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const knowledgeBase = await KnowledgeBaseModel.get(id || "");
if (
  !knowledgeBase ||
  !new ObjectId(knowledgeBase.tenant_id).equals(Astro.locals.tenant._id)
) {
  return Astro.redirect("/404");
}

let userPermissions = Astro.locals.user.permissions;
const mode = Astro.url?.searchParams?.get?.("mode") ?? "update";
console.log(mode);
---

<Layout>
  <div>
    <KnowledgeBaseForm
      knowledgeBaseId={id}
      knowledgeBase={knowledgeBase}
      isEditable={userPermissions.includes(Permission.AdminAll)}
      mode={mode}
      client:load
    />
  </div>
</Layout>
