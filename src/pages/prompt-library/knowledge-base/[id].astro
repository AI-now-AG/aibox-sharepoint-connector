---
import Layout from "$layouts/Layout.astro";
import KnowledgeBaseModel from "$data/models/knowledgeBase.model";
import KnowledgeBaseForm from "$pages/prompt-library/knowledge-base/KnowledgeBaseForm.svelte";
import { Permission } from "$data/models/user.model";

export interface Props {
  id: string;
}

const { id } = Astro.params;

const knowledgeBase = id ? await KnowledgeBaseModel.get(id) : undefined; // TODO: Render 404 if not found
let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div>
    <KnowledgeBaseForm
      preferredLocale={Astro.preferredLocale}
      knowledgeBaseId={id}
      knowledgeBase={knowledgeBase}
      isEditable={userPermissions.includes(Permission.AdminAll)}
      client:load
    />
  </div>
</Layout>
