---
// Component
import Layout from "$layouts/Layout.astro";
import { FeaturePermission } from "$types/Users";
import { isFeaturePermissionEnabled } from "$utils/permission";
import KnowledgeBaseForm from "$components/prompt-library/knowledge-base/KnowledgeBaseForm.svelte";

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <KnowledgeBaseForm
    isEditable={isFeaturePermissionEnabled(
      FeaturePermission.EditKnowledgeBaseInKnowledgeBaseForm,
      userPermissions
    )}
    mode="create"
    client:load
  />
</Layout>
