---
// Component
import Layout from "$layouts/Layout.astro";
import KnowledgeBaseForm from "$pages/prompt-library/knowledge-base/KnowledgeBaseForm.svelte";
import { Permission } from "$data/models/user.model";

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <KnowledgeBaseForm
    isEditable={userPermissions.includes(Permission.AdminAll)}
    client:load
  />
</Layout>
