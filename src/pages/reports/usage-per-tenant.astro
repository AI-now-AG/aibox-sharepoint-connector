---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import UsagePerTenant from "$components/usage/UsagePerTenant.svelte";
import TenantModel from "$data/models/tenant.model";
import { transformRawData } from "$utils/transformRawData";

const t = useTranslations();

const tenants = await TenantModel.list();
const tenantList = transformRawData(tenants);
---

<Layout>
  <div class="container max-w-6xl mx-auto grid grid-cols-1 px-14">
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("nav.usage")}
    </h1>
  </div>
  <div class="container max-w-6xl mx-auto grid grid-cols-1 px-14">
    <UsagePerTenant tenants={tenantList} client:load />
  </div>
</Layout>
