---
import BlankLayout from "$layouts/BlankLayout.astro";
---

<BlankLayout title="Page not found">
  <section class="flex items-center h-full p-16">
    <div
      class="container flex flex-col items-center justify-center px-5 mx-auto my-8"
    >
      <div class="max-w-lg text-center">
        <h2 class="mb-8 font-extrabold text-9xl">
          <span class="sr-only">Error</span>404
        </h2>
        <p class="text-1xl font-semibold md:text-2xl">
          Sorry, we couldn't find this page.
        </p>
        <p class="mt-4 mb-8">
          But dont worry, you can find plenty of other things on our homepage.
        </p>
        <a
          rel="noopener noreferrer"
          href="/"
          class="btn btn-outline btn-primary">Back to homepage</a
        >
      </div>
    </div>
  </section>
</BlankLayout>
