---
import Layout from "$layouts/Layout.astro";
import GlobalCategoryModel from "$data/models/globalCategory.model";
import { Permission } from "$types/Users";
import CategoryForm from "$components/prompt-library/categories/CategoryForm.svelte";
import { transformRawData } from "$utils/transformRawData";

export interface Props {
  id: string;
}

const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const category = await GlobalCategoryModel.get(id);
if (!category) {
  return Astro.redirect("/404");
}

const formattedCategory = transformRawData(category, false);

let userPermissions = Astro.locals.user.permissions;
---

<Layout>
  <div>
    <CategoryForm
      category={formattedCategory}
      isEditable={userPermissions.includes(Permission.AdminAll)}
      client:load
    />
  </div>
</Layout>
