---
import Layout from "$layouts/Layout.astro";
import TenantModel from "$data/models/tenant.model";
import TagManagerForm from "./TagManagerForm.svelte";

const resellerCodes = await TenantModel.listAllResellerCodes();
---

<Layout>
  <div>
    <TagManagerForm {resellerCodes} client:load />
  </div>
</Layout>

<script
  type="module"
  src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js"></script>
