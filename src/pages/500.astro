---
import BlankLayout from "$layouts/BlankLayout.astro";

interface Props {
  error: unknown;
}

export const prerender = false;

const { error } = Astro.props;
const code = Astro.url.searchParams.get("code");
const description = Astro.url.searchParams.get("description");
---

<BlankLayout title="Internal server error">
  <section class="flex items-center h-full p-16">
    <div
      class="container flex flex-col items-center justify-center px-5 mx-auto my-8"
    >
      <div class="max-w-lg text-center">
        {/* Error exception throw from middlewares & pages  */}
        {
          (error || !code) && (
            <Fragment>
              <h1 class="mb-5 text-4xl font-extrabold">Server error</h1>
              <p class="mb-8 text-1xl">
                {error instanceof Error
                  ? error.message
                  : "Sorry, something went wrong on our end. Please try refreshing the page or come back later."}
              </p>
            </Fragment>
          )
        }

        {/* Error code & description from query string */}
        {
          (code || description) && (
            <Fragment>
              <h1 class="mb-5 text-4xl font-extrabold">
                {code?.toUpperCase()}
              </h1>
              <p class="mb-8 text-1xl">{description}</p>
            </Fragment>
          )
        }
        <a
          rel="noopener noreferrer"
          href="/"
          class="btn btn-outline btn-primary">Back to homepage</a
        >
      </div>
    </div>
  </section>
</BlankLayout>
