---
import Layout from "$layouts/Layout.astro";
import { isProd } from "$utils/env";
import { cached } from "$utils/cache";

const { tenant } = Astro.locals;
const adminToken =
  "gjECis74Yf_o6cBjVfteQ2pIFBDXCHVLcgFphFUs46k8ejdjPRI-KqpLyWR8dpbIpJZD-ogVSyYbZVJ7FrYMmBH8OvXqNsiLrxZx8-_fBoHSuUbpkNVB39fz19EG4xzxCwy4iNfTl6T9vpE_aoF8fjskFhl-Lk0LHMeJaWC0k9w";

const cacheKey = `${Astro.locals.user.id}:flowmate:icenter`;

const userToken = await cached(cacheKey, 60 * 60, async () => {
  const res = await fetch(
    "https://api.platform.openintegrationhub.com/impersonate",
    {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${adminToken}`,
      },
      body: JSON.stringify({
        username: Astro.locals.user.email,
      }),
    },
  );

  if (!res.ok) {
    throw new Error("Failed to fetch integration-center token");
  }

  const { token } = await res.json();
  return token;
});

const language = tenant.default_language || "de";
const groups = [tenant.org_name || "default"];
groups.push(isProd() ? "prod" : "dev");
---

<Layout title="FlowMate">
  <script
    src="https://integration-center.cloud-ecosystem.workers.dev/build/integration-center.js"
    defer></script>

  <div class="container max-w-8xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">FlowMate - Integration Center</h1>

    <integration-center
      token={userToken}
      groups={groups.join(",")}
      language={language}></integration-center>
  </div>
</Layout>
