---
// Component
import Layout from "$layouts/Layout.astro";
import Content from "$components/prompt-interface/Content.astro";
import CategoryModel from "$data/models/category.model";
import PromptModel, { type Prompt } from "$data/models/prompt.model";
import { isSameObjectId } from "$utils/common";

const { category: categoryId, group: groupId } = Astro.params;

const category = await CategoryModel.get(categoryId as string);
if (
  !category ||
  (category && !isSameObjectId(category.tenant_id, Astro.locals.tenant._id))
) {
  return Astro.rewrite("/404");
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const group = category?.groups.find((g: any) => g._id.toString() === groupId);
const prompts = await PromptModel.listByCategory(categoryId as string);

const categoryPrompt = prompts.filter(
  (p: Prompt) => p.category?.toString() === categoryId
);
const categoryGroupPrompt = categoryPrompt.filter(
  (p: Prompt) => p.group?.toString() === group?._id?.toString()
);
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const promptItems = categoryGroupPrompt.map((prompt: any) => ({
  _id: prompt._id?.toString(),
  title: prompt.title,
  description: prompt.description,
  prompt: prompt.prompt,
  model: prompt.model,
  reasoningEffort: prompt.reasoningEffort,
  textVerbosity: prompt.textVerbosity,
  promptTool: prompt.promptTool,
  predefined_input: prompt.predefined_input,
}));
---

<Layout>
  <div
    class="flex flex-col bg-base-200 h-full content-baseline gap-0 place-items-center"
  >
    <div class="w-full h-full">
      <Content {group} {promptItems} />
    </div>
  </div>
</Layout>
