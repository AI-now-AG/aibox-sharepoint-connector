---
// Component
import Layout from "$layouts/Layout.astro";
import Content from "$components/prompt-interface/components/Content.astro";
import CategoryModel from "$data/models/category.model";
import { ObjectId } from "mongodb";

const { category: categoryId, group: groupId } = Astro.params;

const category = await CategoryModel.get(categoryId || "");
if (
  !category ||
  !new ObjectId(category.tenant_id).equals(Astro.locals.tenant._id)
) {
  return Astro.redirect("/404");
}
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const group = category?.groups.find((g: any) => g._id.toString() === groupId);
if (!group) {
  return Astro.redirect("/404");
}
---

<Layout>
  <!-- <div
    class="grid grid-cols-1 xl:grid-cols-[1fr_minmax(min-content,420px)] bg-base-200 h-full"
    > -->
  <!-- <div
    class="grid grid-cols-1 grid-rows-[min-content-1fr] bg-base-200 h-full content-baseline gap-0 place-items-center"
  > -->
  <div
    class="flex flex-col bg-base-200 h-full content-baseline gap-0 place-items-center"
  >
    <div class="w-full h-full">
      <Content />
    </div>
  </div>
</Layout>
