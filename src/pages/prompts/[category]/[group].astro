---
// Component
import Layout from "$layouts/Layout.astro";
import Content from "$components/prompt-interface/components/Content.astro";
import History from "$components/prompt-interface/components/History.astro";
---

<Layout>
  <div
    class="grid grid-cols-1 md:grid-rows-[1fr_max-lg_minmax(min-content,_320px)] xl:grid-cols-[1fr_min-content_minmax(min-content,_320px)] bg-base-200 h-full"
  >
    <div class="p-6">
      <Content />
    </div>

    <div class="divider xl:divider-horizontal"></div>

    <div class="py-6 hidden xl:block">
      <History />
    </div>
  </div>
</Layout>
