---
import Layout from "$layouts/Layout.astro";
import { actions } from "astro:actions";
import AIChatWidget from "$pages/home/AIChatWidget.svelte";
import PosthogEventTrigger from "$pages/home/PosthogEventTrigger.svelte";
import { useTranslations } from "$i18n/utils";
import { TourType } from "$types/Users";
import type { CardItem } from "$components/Card.svelte";
import CategoryModel from "$data/models/category.model";
import PromptModel from "$data/models/prompt.model";
const t = useTranslations();

const tenant = Astro.locals.tenant;
const onboarding = Astro.url?.searchParams?.get?.("onboarding");
if (onboarding) {
  const user = Astro.locals.user;
  await Astro.callAction(actions.user.resetLoginCount, {
    _id: user.id.toString(),
  });
  await Astro.callAction(actions.user.activeOboarding, {
    _id: user.id.toString(),
    type: TourType.Onboarding,
  });
  await Astro.callAction(actions.user.activeOboarding, {
    _id: user.id.toString(),
    type: TourType.OnboardingNewTenant,
  });
}

const onboardingNew = Astro.url?.searchParams?.get?.("onboardingnew");
if (onboardingNew) {
  const user = Astro.locals.user;
  await Astro.callAction(actions.user.resetLoginCount, {
    _id: user.id.toString(),
  });
  await Astro.callAction(actions.user.activeOboarding, {
    _id: user.id.toString(),
    type: TourType.OnboardingNewTenant,
  });
}

// ------------------------------------------------------

const promptsCursor = await PromptModel.listByTenant(tenant._id);
const prompts = await promptsCursor.toArray();

const calls = prompts.map(async (prompt) => {
  if (!prompt.category) return null;
  const category = await CategoryModel.get(prompt.category.toString());
  return category;
});

const categories = (await Promise.all(calls)) as any;

const promptsEnriched: CardItem[] = prompts.map((prompt: any) => {
  const category = categories.find(
    (category: any) => category?._id.toString() === prompt.category?.toString(),
  );

  const group = category?.groups.find(
    (g: any) => g._id?.toString() === prompt.group?.toString(),
  );

  const tags = [category?.title, group?.title].filter(Boolean) as string[];
  return {
    title: prompt.title,
    description: prompt.description,
    instruction: prompt.prompt,
    id: prompt._id.toString(),
    category: prompt.category?.toString(),
    group: prompt.group?.toString(),
    model: prompt.model,
    predefined_input: prompt.predefined_input,
    tags,
  };
});
---

<Layout>
  <div
    class="flex flex-col bg-base-200 content-baseline gap-0 place-items-center"
  >
    <div class="w-full px-16 py-auto">
      <div class="mt-8 text-center space-y-8 max-w-3xl mx-auto">
        <img
          src="/logo-aibox-christmasedition.svg"
          alt="Weihnachtsmann Logo"
          class="h-8 hidden in-data-[theme=weihnachtsmann]:inline"
        />
        <img
          src="/soki-somedia.png"
          alt="somedia logo"
          class="h-12 hidden in-data-[theme=somedia]:inline"
        />
        <img
          src="/aibox-logo-text.svg"
          alt="light logo"
          class="w-auto h-12 w-auto hidden in-data-[theme=light]:inline"
        />
        <img
          src="/aibox-logo-text.svg"
          alt="light logo"
          class="w-auto h-12 w-auto hidden in-data-[theme=aibox]:inline"
        />
        <img
          src="/aibox-logo-text-dark.svg"
          alt="dark logo"
          class="w-auto h-12 hidden in-data-[theme=dark]:inline"
        />

        <h1 class="text-4xl font-bold mt-9 mb-4">
          {t("home.welcome", { name: Astro.locals.user.name })}
        </h1>
      </div>
    </div>
  </div>

  <div
    class="flex flex-col bg-base-200 h-full content-baseline gap-0 place-items-center mt-8"
  >
    <div class="px-16 py-6 w-full h-full">
      <div class="flex flex-col h-full max-w-6xl mx-auto">
        <AIChatWidget
          apiKeyProviders={tenant.api_key_providers}
          folderName={tenant.org_name}
          promptsEnriched={promptsEnriched}
          client:load
        />
      </div>
    </div>
  </div>
  <PosthogEventTrigger client:load />
</Layout>
