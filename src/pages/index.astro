---
// Component
import Layout from "$layouts/Layout.astro";
import Card from "$components/content/Card.astro";
import { useTranslations } from "$i18n/utils";

const t = useTranslations(Astro.preferredLocale);
---

<Layout isFooterVisible={true}>
  <div class="p-4 flex-1 flex-col w-100 h-100 mt-8 text-center space-y-16">
    <h1 class="text-4xl font-bold mt-9 mb-4">{t("welcome.title")}</h1>
    <p class="text-xl">{t("welcome.text")}</p>
  </div>

  <div>
    <Card
      title="foo"
      lead="bar"
      href="/content/onboarding"
      image={{ src: "", alt: "tmp" }}
    />
  </div>
</Layout>
