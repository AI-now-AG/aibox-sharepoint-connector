---
import TestSentryClient from "$components/debug/TestSentryClient.svelte";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Sentry Client Test</title>
    <style>
      body { font-family: monospace; padding: 2rem; background: #0f172a; color: #e2e8f0; }
      h1 { color: #f8fafc; margin-bottom: 1.5rem; }
    </style>
  </head>
  <body>
    <h1>🔍 Sentry Client-Side Test</h1>
    <TestSentryClient client:load />


    <button id="one" type="button">Throw a frontend error</button>
    <button id="two" type="button">Throw an API error</button>


    <script is:inline>
      const buttonOne = document.getElementById("one");
      const buttonTwo = document.getElementById("two");
      buttonOne.addEventListener("click", throwTestError);
      buttonTwo.addEventListener("click", throwApiError);
      function throwTestError() {
        throw new Error("Sentry Example Frontend Error");
      }
      async function throwApiError() {
        await fetch("/api/test-error");
      }
    </script>
  </body>
</html>
