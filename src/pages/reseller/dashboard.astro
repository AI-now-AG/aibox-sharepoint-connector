---
import Layout from "$layouts/Layout.astro";
import auth from "$auth/auth";
import ResellerTenantList from "./ResellerTenantList.svelte";

const isReseller = Astro.locals.tenant?.is_reseller === true;
const hasAccess =
  auth.isReseller(Astro.locals) ||
  auth.isSuperAdmin(Astro.locals) ||
  auth.isAdmin(Astro.locals);

if (!isReseller || !hasAccess) {
  return Astro.rewrite("/restricted");
}

const resellerCode = Astro.locals.tenant.reseller_code;
---

<Layout>
  <ResellerTenantList {resellerCode} client:load />
</Layout>
