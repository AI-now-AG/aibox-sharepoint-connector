---
import Layout from "$layouts/Layout.astro";
import { ObjectId } from "mongodb";
import GlobalTagModel from "$data/models/globalTag.model";
import GlobalCategoryModel from "$data/models/globalCategory.model";
import { type TagItem, type CategoryItem } from "$types/Subscription";
import auth from "$auth/auth";
import CreateTenantAccount from "$components/tenant/CreateTenantAccount.svelte";
import { useTranslations } from "$i18n/utils";

const t = useTranslations();

const allTags = await GlobalTagModel.list();
const allCategories = await GlobalCategoryModel.list();

const tags: TagItem[] = allTags.map((tag) => {
  return {
    title: tag.title,
    value: tag._id.toString(),
    description: tag.description,
    icon: tag.icon,
    iconColor: tag.iconColor,
  };
});

const categories: CategoryItem[] = allCategories.map((category) => {
  return {
    title: category.title,
    value: category._id.toString(),
    tags: category.tags?.map((t: ObjectId) => t.toString()) ?? [],
  };
});

const isReseller = Astro.locals.tenant?.is_reseller ?? false;
const resellerCode = Astro.locals.tenant?.reseller_code ?? null;
if (!isReseller || !auth.isReseller(Astro.locals)) {
  //return Astro.redirect("/restricted");
}
---

<Layout>
  <CreateTenantAccount
    pageTitle={t("reseller.create-account-title")}
    {tags}
    {categories}
    isReseller={true}
    {resellerCode}
    client:load
  />
</Layout>
