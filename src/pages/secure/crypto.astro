---
import Layout from "$layouts/Layout.astro";
import CryptoForm from "./CryptoForm.svelte";
---

<Layout>
  <div
    class="container max-w-full mx-auto grid grid-cols-1 md:grid-cols-[1fr_max-content] px-14"
  >
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">Encrypt & Decrypt API Keys</h1>
  </div>
  <div class="px-8">
    <CryptoForm client:load />
  </div>
</Layout>
