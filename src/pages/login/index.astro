---
import Head from "$layouts/Head.astro";
import { useTranslations } from "$i18n/utils";

const t = useTranslations(Astro.preferredLocale);
---

<html lang="en" data-theme="somedia">
  <Head />

  <body>
    <div class="h-screen bg-base-200 grid grid-cols-1 lg:grid-cols-2">
      <div
        class="lg:block hidden bg-primary content-center p-10 bg-cover bg-center"
      >
        <h1 class="text-base-100 font-bold text-8xl">
          {t("login.welcome")}
          <br />
          <div class="w-max">
            <h1
              class="animate-typing overflow-hidden whitespace-nowrap border-r-4 border-r-white pr-5 text-warning"
            >
              aibox
            </h1>
          </div>
        </h1>
      </div>
      <div
        class="flex flex-col p-5 md:p-10 items-center justify-center content-center"
      >
        <h2
          class="text-3xl font-bold mb-5 text-center sm:pb-4 md:pb-10 lg:pb-20"
        >
          {t("login.title")}
        </h2>

        <form
          class="bg-base-100 shadow-md rounded-xl p-5 md:p-10 w-full max-w-md"
          method="post"
          action="/api/login"
          novalidate
        >
          <div>
            <label class="input input-bordered flex items-center gap-2 mb-5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 16 16"
                fill="currentColor"
                class="h-4 w-4 opacity-70"
              >
                <path
                  d="M2.5 3A1.5 1.5 0 0 0 1 4.5v.793c.026.009.051.02.076.032L7.674 8.51c.206.1.446.1.652 0l6.598-3.185A.755.755 0 0 1 15 5.293V4.5A1.5 1.5 0 0 0 13.5 3h-11Z"
                ></path>
                <path
                  d="M15 6.954 8.978 9.86a2.25 2.25 0 0 1-1.956 0L1 6.954V11.5A1.5 1.5 0 0 0 2.5 13h11a1.5 1.5 0 0 0 1.5-1.5V6.954Z"
                ></path>
              </svg>
              <input
                name="email"
                id="email"
                type="text"
                class="grow"
                placeholder={t("login.email")}
              />
            </label>
            <label class="input input-bordered flex items-center gap-2 mb-5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 16 16"
                fill="currentColor"
                class="h-4 w-4 opacity-70"
              >
                <path
                  fill-rule="evenodd"
                  d="M14 6a4 4 0 0 1-4.899 3.899l-1.955 1.955a.5.5 0 0 1-.353.146H5v1.5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-2.293a.5.5 0 0 1 .146-.353l3.955-3.955A4 4 0 1 1 14 6Zm-4-2a.75.75 0 0 0 0 1.5.5.5 0 0 1 .5.5.75.75 0 0 0 1.5 0 2 2 0 0 0-2-2Z"
                  clip-rule="evenodd"></path>
              </svg>
              <input
                name="password"
                id="password"
                type="password"
                class="grow"
                placeholder={t("login.password")}
              />
            </label>
          </div>
          <button
            type="submit"
            class="bg-primary hover:bg-primary-focus text-base-100 font-bold py-2 px-4 rounded-md w-full"
          >
            {t("login.submit")}
          </button>
          <p id="form-error" class="text-error item-center text-right py-2"></p>
        </form>
      </div>
    </div>

    <script>
      const errorMessageElement = document.getElementById("form-error")!;

      document.forms[0].addEventListener("submit", (e) => {
        e.preventDefault();
        const formElement = e.target as HTMLFormElement;
        fetchUserData(formElement);
      });

      async function fetchUserData(formElement: HTMLFormElement) {
        try {
          const response = await fetch("/api/login", {
            method: formElement.method,
            body: new FormData(formElement),
          });
          if (response.ok) {
            window.location.href = "/";
          } else {
            errorMessageElement.innerText =
              "\u{2022} " + (await response.json()).message;
          }
        } catch (error) {
          console.error("Fetch login error:" + error);
        }
      }
    </script>
  </body>
</html>
