---
import Login from "./login.svelte";
---

<div class="h-screen bg-base-200 grid grid-cols-1 lg:grid-cols-2">
  <div
    class="lg:block hidden bg-primary content-center p-10 bg-cover bg-center"
  >
    <h1 class="text-base-100 font-bold text-8xl">
      welcome to
      <br />
      <div class="w-max">
        <h1
          class="animate-typing overflow-hidden whitespace-nowrap border-r-4 border-r-white pr-5 text-warning"
        >
          aibox
        </h1>
      </div>
    </h1>
  </div>
  <div
    class="flex flex-col p-5 md:p-10 items-center justify-center content-center"
  >
    <h2 class="text-3xl font-bold mb-5 text-center sm:pb-4 md:pb-10 lg:pb-20">
      Sign in to your acccount
    </h2>

    <form
      class="bg-base-100 shadow-md rounded-xl p-5 md:p-10 w-full max-w-md"
      method="post"
      action="/api/login"
      novalidate
    >
      <Login client:load />
      <button
        type="submit"
        class="bg-primary hover:bg-primary-focus text-base-100 font-bold py-2 px-4 rounded-md w-full"
      >
        Login
      </button>
      <p id="form-error" class="text-error item-center text-right py-2"></p>
    </form>
  </div>
</div>

<script>
  const errorMessageElement = document.getElementById("form-error")!;
  
  document.forms[0].addEventListener("submit", (e) => {
    e.preventDefault();
    const formElement = e.target as HTMLFormElement;
    fetchUserData(formElement);
  });

  async function fetchUserData(formElement: HTMLFormElement) {
    try {
      const response = await fetch("/api/login", {
        method: formElement.method,
        body: new FormData(formElement),
      })
      if (response.ok) {
			window.location.href = "/";
		} else {
			errorMessageElement.innerText = '\u{2022} ' + (await response.json()).message;
		}
    } catch (error) {
      console.error("Fetch login error:" + error);
    }
  }
</script>
