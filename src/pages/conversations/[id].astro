---
// Component
import Layout from "$layouts/Layout.astro";
import ChatView from "./ChatView.svelte";
import ConversationModel from "$data/models/conversation.model";
import PromptModel from "$data/models/prompt.model";

const { id } = Astro.params;
const tenant = Astro.locals.tenant;
const conversation = await ConversationModel.get(id || "");
if (!conversation || !conversation.creator_id.equals(Astro.locals.user.id)) {
  return Astro.redirect("/404");
}
const prompt = await PromptModel.get(conversation.prompt_id || "");
---

<Layout>
  <div
    class="flex flex-col bg-base-200 h-full content-baseline gap-0 place-items-center"
  >
    <div class="px-16 w-full max-w-6xl h-full">
      <div class="flex flex-col h-full max-w-6xl mx-auto">
        <h1 class="pt-2 mb-2 lg:pt-8 text-4xl font-bold">
          {conversation?.title || prompt?.title || ""}
        </h1>

        <ChatView
          conversationId={id?.toString()}
          model={conversation.model}
          messages={conversation.messages || []}
          promptData={prompt}
          folderName={tenant.org_name}
          lastResponseId={conversation.previous_response_id}
          client:load
        />
      </div>
    </div>
  </div>
</Layout>
