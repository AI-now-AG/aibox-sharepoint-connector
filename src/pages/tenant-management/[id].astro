---
import Layout from "$layouts/Layout.astro";
import TenantForm from "./TenantForm.svelte";
import TenantModel from "$data/models/tenant.model";
import { decrypt } from "$utils/secure";
import { transformRawData } from "$utils/transformRawData";

export interface Props {
  id: string;
}

const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const tenant = await TenantModel.get(id);
if (!tenant) {
  return Astro.redirect("/404");
}

const data = transformRawData(tenant);
const { openai_api_key, azure_openai_api_key, speech_api_key, perplexity_api_key } = data || {};
let openAIKey = "";
let azureOpenAIKey = "";
let perplexityKey = "";
let azureSpeechKey = "";

if (openai_api_key) {
  openAIKey = decrypt(openai_api_key);
}

if (azure_openai_api_key) {
  azureOpenAIKey = decrypt(azure_openai_api_key);
}

if (speech_api_key) {
  azureSpeechKey = decrypt(speech_api_key);
}

if (perplexity_api_key) {
  perplexityKey = decrypt(perplexity_api_key);
}
---

<Layout>
  <TenantForm
    tenant={data}
    openAIKey={openAIKey?.trim()}
    azureOpenAIKey={azureOpenAIKey?.trim()}
    perplexityKey={perplexityKey?.trim()}
    azureSpeechKey={azureSpeechKey?.trim()}
    client:load
  />
</Layout>
