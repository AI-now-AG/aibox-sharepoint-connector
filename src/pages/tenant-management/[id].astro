---
import Layout from "$layouts/Layout.astro";
import TenantForm from "./TenantForm.svelte";
import { actions } from "astro:actions";
import { decrypt } from "$utils/secure";
import log from "$utils/log";

export interface Props {
  id: string;
}

const { id = "" } = Astro.params;

const fetchTenant = async () => {
  const { data, error } = await Astro.callAction(actions.tenant.get, {
    _id: id,
  });
  return { data, error };
};

const tenatData = await fetchTenant();
const { data } = tenatData || {};
let openAIKey = data.openai_api_key;
let azureOpenAIKey  = data.azure_openai_api_key;
try {
  openAIKey = decrypt(data.openai_api_key);
  azureOpenAIKey = decrypt(data.azure_openai_api_key)
} catch (error) {
  log.e(error, 'Descrypt api key error')
}
---

<Layout>
  <TenantForm
    tenant={data}
    openAIKey={openAIKey}
    azureOpenAIKey={azureOpenAIKey}
    client:load
  />
</Layout>
