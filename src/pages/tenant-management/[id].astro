---
import Layout from "$layouts/Layout.astro";
import TenantFrom from "./TenantFrom.svelte";
import { svgIcons } from "$assets/icons";
import { actions } from "astro:actions";

export interface Props {
  id: string;
}

const { id = "" } = Astro.params;

const fetchTenant = async () => {
  const { data, error } = await Astro.callAction(actions.tenant.get, {
    _id: id,
  });
  return { data, error };
};

const tenatData = await fetchTenant();
// TODO: Clean up mocking data bellow 
// const data = {
//   _id: "66eac0936802b78d28a1e98d",
//   org_name: "business4you 1",
//   name: "Business4you 1",
//   active: true,
//   primary_color: 'pink',
//   theme: 'somedia',
//   default_language: 'de',
//   openai_api_key: 'openai_api_key 123',
//   azure_openai_api_key: 'azure_openai_api_key 456',
//   included_features: ["audio-to-text"]
// };
const { data } = tenatData || {};

---

<Layout>
  <div
    class="container max-w-full mx-auto grid grid-cols-1 md:grid-cols-[1fr_max-content] px-14"
  >
    <div class="flex items-center pt-8">
      <button class="mr-4" onclick="window.history.back();">
        <span set:html={svgIcons.back} />
      </button>
      <h1 class="text-4xl font-bold">{data.name}</h1>
    </div>
  </div>
  <div class="px-8">
    <TenantFrom tenant={data} client:load />
  </div>
</Layout>
