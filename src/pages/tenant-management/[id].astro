---
import Layout from "$layouts/Layout.astro";
import TenantForm from "./TenantForm.svelte";
import TenantModel from "$data/models/tenant.model";
import UserModel from "$data/models/user.model";
import SubscriptionModel from "$data/models/subscription.model";
import { transformRawData } from "$utils/transformRawData";
import { isTestMode } from "$utils/stripe";
import { decrypt } from "$utils/secure";

export interface Props {
  id: string;
}

const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const tenant = await TenantModel.get(id);
if (!tenant) {
  return Astro.redirect("/404");
}
const tenantData = transformRawData(tenant);

[
  "openai_api_key",
  "openai_gpt5_api_key",
  "azure_openai_api_key",
  "speech_api_key",
  "elevenLabs_api_key",
  "perplexity_api_key",
  "fal_ai_api_key",
  "anthropic_api_key",
  "gemini_api_key",
].forEach((key) => {
  tenantData[key] = tenantData[key] ? decrypt(tenantData[key]) : "";
});
const subscription = await SubscriptionModel.getOrCreateSubscription(id);
const subscriptionData = transformRawData(subscription, false);
const countActiveUsers = await UserModel.countActiveUsersByTenant(id);
---

<Layout>
  <TenantForm
    tenant={tenantData}
    subscription={subscriptionData}
    activeUsers={countActiveUsers}
    isStripeInTestMode={isTestMode()}
    client:load
  />
</Layout>
