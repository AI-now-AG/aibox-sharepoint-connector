---
import Layout from "$layouts/Layout.astro";
import TenantForm from "./TenantForm.svelte";
import TenantModel from "$data/models/tenant.model";
import MonthlyUsageModel from "$data/models/monthlyUsage.model";
import { transformRawData } from "$utils/transformRawData";
import { decrypt } from "$utils/secure";

export interface Props {
  id: string;
}

const { id } = Astro.params;
if (id === undefined) {
  throw new Error("Id is required");
}

const tenant = await TenantModel.get(id);
if (!tenant) {
  return Astro.redirect("/404");
}
const monthlyUsage = await MonthlyUsageModel.findOrCreateMonthlyUsage(id);

const tenantData = transformRawData(tenant);
const monthlyUsageData = transformRawData(monthlyUsage);
const usageSettings = monthlyUsageData.services;

[
  "openai_api_key",
  "azure_openai_api_key",
  "speech_api_key",
  "perplexity_api_key",
  "fal_ai_api_key",
].forEach((key) => {
  tenantData[key] = tenantData[key] ? decrypt(tenantData[key]) : "";
});
---

<Layout>
  <TenantForm tenant={tenantData} usageSettings={usageSettings} client:load />
</Layout>
