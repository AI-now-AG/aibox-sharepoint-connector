---
import Layout from "$layouts/Layout.astro";
import TenantForm from "./TenantForm.svelte";
import tenantModel from "$data/models/tenant.model";
import { decrypt } from "$utils/secure";
import { transformDataToArray } from "$utils/transformDataToArray";

export interface Props {
  id: string;
}

const { id } = Astro.params;
console.log('id', id);
if (id === undefined) {
  throw new Error("Id is required");
}

const tenant = await tenantModel.get(id);
if (tenant === null) {
  console.error('Tenant not found');
  return Astro.redirect('/404');
}

const data = transformDataToArray(tenant);
const { openai_api_key, azure_openai_api_key } = data || {};
let openAIKey = openai_api_key;
let azureOpenAIKey = azure_openai_api_key;
try {
  if (openai_api_key) {
    openAIKey = decrypt(openai_api_key);
  }
} catch (error) {
  console.log("Decrypt openAIKey exception", error);
}

try {
  if (azure_openai_api_key) {
    azureOpenAIKey = decrypt(azure_openai_api_key);
  }
} catch (error) {
  console.log("Decrypt azureOpenAIKey exception", error);
}
---

<Layout>
  <TenantForm
    tenant={data}
    openAIKey={openAIKey?.trim()}
    azureOpenAIKey={azureOpenAIKey?.trim()}
    client:load
  />
</Layout>
