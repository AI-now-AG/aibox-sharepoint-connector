---
import Layout from "$layouts/Layout.astro";
import TenantForm from "./TenantForm.svelte";
import { actions } from "astro:actions";
import { decrypt } from "$utils/secure";
import tenantModel from "$data/models/tenant.model";

export interface Props {
  id: string;
}

const { id = "" } = Astro.params;

const fetchTenant = async () => {
  const { data, error } = await Astro.callAction(actions.tenant.get, {
    _id: id,
  });
  console.log("1. { data, error }", { data, error });
  return { data, error };
};


const tenatData = await tenantModel.get(id);
console.log("2. tenatData", tenatData);
const { openai_api_key, azure_openai_api_key } = tenatData || {};
console.log("4. { openai_api_key, azure_openai_api_key }", {
  openai_api_key,
  azure_openai_api_key,
});
let openAIKey = openai_api_key;
let azureOpenAIKey = azure_openai_api_key;
console.log("5. {openAIKey,azureOpenAIKey }", { openAIKey, azureOpenAIKey });
try {
  if (openai_api_key) {
    console.log("6.1. daopenai_api_keyta", openai_api_key);
    openAIKey = decrypt(openai_api_key);
    console.log("6.2. daopenai_api_keyta", openai_api_key);
  }
} catch (error) {
  console.log("Decrypt openAIKey exception", error);
}

try {
  if (azure_openai_api_key) {
    console.log("7.1. azure_openai_api_key", azure_openai_api_key);
    azureOpenAIKey = decrypt(azure_openai_api_key);
    console.log("7.2. azure_openai_api_key", azure_openai_api_key);
  }
} catch (error) {
  console.log("Decrypt azureOpenAIKey exception", error);
}
---

<Layout>
  <TenantForm
    tenant={tenatData}
    openAIKey={openAIKey?.trim()}
    azureOpenAIKey={azureOpenAIKey?.trim()}
    client:load
  />
</Layout>
