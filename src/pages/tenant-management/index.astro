---
import Layout from "$layouts/Layout.astro";
import { useTranslations } from "$i18n/utils";
import TenantList from "$pages/tenant-management/TenantList.svelte";
import { svgIcons } from "$assets/icons";

const t = useTranslations(Astro.preferredLocale);
---

<Layout>
  <div
    class="container max-w-full mx-auto grid grid-cols-1 md:grid-cols-[1fr_max-content] px-14"
  >
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      {t("tenant.tenants")}
    </h1>

    <a
      href="tenant-management/add"
      class="mt-2 lg:mt-8 btn btn-active btn-neutral font-normal grow-0"
    >
      <span set:html={svgIcons.add} />
      {t("tenant.tenants.add-new-tenant")}
    </a>
  </div>
  <div class="px-8">
    <TenantList client:load preferredLocale={Astro.preferredLocale} />
  </div>
</Layout>
