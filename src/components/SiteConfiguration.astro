---
import i18n from "$utils/i18n";

const { tenant } = Astro.locals;
const theme = tenant?.theme;
const primaryColor = "rgb(24 121 78)";
const defaultLanguage = tenant?.default_language;

i18n.setLocale("de");
console.log("primaryColor", { primaryColor });
---

<style define:vars={{ primaryColor }} is:global>
  :root,
  [data-theme] {
    --bc: var(--primaryColor);
  }
</style>

<script define:vars={{ theme }} is:inline>
  // set default theme in storage
  const savedTheme = localStorage.getItem("theme");
  if (theme && !savedTheme) {
    localStorage.setItem("theme", theme);
  }
</script>
