---
import { useTranslations } from "$i18n/utils";
import MenuItem from "./MenuItem.astro";
import ConversationItems from "./ConversationItems.svelte";
import Category from "$data/models/category.model";
import { AudioCategory, TenantFeature } from "$types/TenantFeature";
import { TranscriptionType } from "$types/TranscribeRequest";
import { svgIcons } from "$assets/icons";
import auth from "$auth/auth";
import { ApiKeyProvider } from "$types/TenantFeature";
import TranscriptionModel from "$data/models/transcription.model";
import { transformRawData } from "$utils/transformRawData";
import { cached } from "$utils/cache";

const t = useTranslations();

interface Props {
  conversations?: Array<unknown>;
}

const { conversations = [] } = Astro.props as Props;

const categories = await cached(
  `categories:${Astro.locals.user.tenant_id}`,
  1000 * 60 * 0.5,
  async () => {
    const cursor = await await Category.listActiveByTenant(
      Astro.locals.user.tenant_id
    );
    return await cursor.toArray();
  }
);

const transcriptions = await cached(
  `transcriptions:${Astro.locals.user.tenant_id}`,
  1000 * 60 * 2,
  async () => {
    const data = await TranscriptionModel.listByTenant(
      Astro.locals.user.tenant_id
    );
    return data;
  }
);

const navState = Astro.locals.user.navState || {};
const isNavCollapsed = navState["nav-collapsed"] ?? false;

const menuItems = categories.map((category, index) => ({
  title: category.title,
  icon: category.icon,
  isOpened: navState[`ai-tools-module-${index}`] ?? false,
  items: category.groups
    ?.filter((group) => {
      return group?.active && group.active == true;
    })
    .map((group) => ({
      title: group.title,
      path: `/prompts/${category._id}/${group._id}`,
    })),
}));

const audioToTextMenus = [];
const audioFeatureItems = [];
const subtitleStudioMenus = [];
const subtitleFeatureItems = [];

const createImageMenus = [];
const createImageItems = [];

const myAIBoxMenus = [];

const transcriptionTypes = Astro.locals.tenant.transcription_types ?? [];

const activeTranscriptions =
  transcriptions?.filter(
    (tran) =>
      transcriptionTypes.includes(tran.category) && tran.enabled === true
  ) ?? [];

const audioToTextTranscriptions = activeTranscriptions
  .filter((tran) => tran.category == AudioCategory.AudioToText)
  .map((tran) => ({
    title: tran.name,
    path: `/transcription/${tran._id.toString()}`,
    usecaseId: tran._id.toString(),
  }));

const subtitleTranscriptions = activeTranscriptions
  .filter(
    (tran) =>
      tran.category == AudioCategory.Subtitle ||
      tran.category == AudioCategory.SubtitleJson ||
      tran.category == AudioCategory.SubtitleLarge ||
      tran.category == AudioCategory.Subtitle11Labs
  )
  .map((tran) => ({
    title: tran.name,
    path: `/transcription/${tran._id.toString()}`,
    usecaseId: tran._id.toString(),
  }));

if (audioToTextTranscriptions.length > 0) {
  audioFeatureItems.push({
    title: t("nav.audiotool.audio-to-text"),
    isOpened: navState["audio-menu-id-0"] ?? false,
    items: audioToTextTranscriptions,
  });
}

if (subtitleTranscriptions.length > 0) {
  subtitleFeatureItems.push({
    title: t("settings.transcription.subtitles-title"),
    isOpened: navState["subtitle-menu-id-0"] ?? false,
    items: subtitleTranscriptions,
  });
}

if (Astro.locals.tenant.subtitle_editor) {
  subtitleFeatureItems.push({
    title: t("settings.transcription.subtitle-editor"),
    path: `/subtitle-studio/editor`,
  });
}

if (transcriptionTypes.includes(AudioCategory.AudioPro)) {
  audioFeatureItems.push({
    title: t("settings.transcription.largefile-title"),
    path: `/transcription/${TranscriptionType.Largefile}`,
    transcriptionType: TranscriptionType.Largefile,
  });
}

if (audioFeatureItems.length > 0) {
  audioToTextMenus.push({
    title: t("nav.audiotool"),
    icon: svgIcons.audio,
    isOpened: navState["audio-menu"] ?? false,
    items: audioFeatureItems,
  });
}

if (subtitleFeatureItems.length > 0) {
  subtitleStudioMenus.push({
    title: t("nav.subtitle-studio"),
    icon: svgIcons.subtitle,
    isOpened: navState["subtitle-menu"] ?? false,
    items: subtitleFeatureItems,
  });
}

// Image Assistant > DALL-E
if (
  auth.hasFeatureWithProvider(
    Astro.locals,
    TenantFeature.CreateImage,
    ApiKeyProvider.OpenAI
  )
) {
  createImageItems.push({
    title: t("nav.create-image.dall-e"),
    path: "/image-creation/dalle3",
  });
}

// Image Assistant > Flux
if (
  auth.hasFeatureWithProvider(
    Astro.locals,
    TenantFeature.CreateImage,
    ApiKeyProvider.Flux
  )
) {
  createImageItems.push({
    title: t("nav.create-image.flux"),
    path: "/image-creation/flux",
  });
}

// Image Assistant > GPT Image
if (
  auth.hasFeatureWithProvider(
    Astro.locals,
    TenantFeature.GptImage,
    ApiKeyProvider.OpenAI
  )
) {
  createImageItems.push({
    title: t("nav.create-image.gpt"),
    path: "/image-creation/gpt",
  });
}

// Image Assistant > Gemini Nano Banana
if (
  auth.hasFeatureWithProvider(
    Astro.locals,
    TenantFeature.CreateImage,
    ApiKeyProvider.Gemini
  )
) {
  createImageItems.push({
    title: t("nav.create-image.nano-banana"),
    path: "/image-creation/nano-banana",
  });
}
if (createImageItems.length > 0) {
  createImageMenus.push({
    title: t("nav.create-image"),
    icon: svgIcons.image,
    isOpened: navState["create-image"] ?? false,
    items: createImageItems,
  });
}

if (conversations.length > 0) {
  myAIBoxMenus.push({
    title: t("conversation.my-ai-box-nav-title"),
    icon: svgIcons.chat,
    isOpened: navState["my-ai-box"] ?? false,
    items: [],
  });
}

const adminMenus = [];
const supperAdminMenus = [];
const settingsItems = [
  {
    title: t("nav.settings.prompts"),
    path: "/prompt-library/prompts",
  },
  {
    title: t("nav.settings.knowledge-base"),
    path: "/prompt-library/knowledge-base",
  },
  {
    title: t("nav.settings.categories"),
    path: "/prompt-library/categories",
  },
];

if (auth.hasFeature(Astro.locals, TenantFeature.AudioToText)) {
  settingsItems.push({
    title: t("nav.settings.audio"),
    path: "/settings/transcription",
  });
}

if (auth.isAdmin(Astro.locals) || auth.isSuperAdmin(Astro.locals)) {
  settingsItems.push({
    title: t("user.user-management"),
    path: "/user-management",
  });
  settingsItems.push({
    title: t("nav.subscription"),
    path: "/settings/subscription",
  });
  settingsItems.push({
    title: t("nav.usage"),
    path: `/billing/usage`,
  });
  adminMenus.push({
    title: t("nav.settings"),
    icon: svgIcons.menuSettings,
    isOpened: navState[`admin-menu`] ?? false,
    items: settingsItems,
  });
}

if (auth.isSuperAdmin(Astro.locals)) {
  supperAdminMenus.push({
    title: t("nav.settings.admin"),
    icon: svgIcons.admin,
    isOpened: navState[`supper-admin-menu`] ?? false,
    items: [
      {
        title: t("nav.tenant-management"),
        path: `/tenant-management`,
      },
      {
        title: "Global Assistant Library",
        isOpened: navState[`admin-menu-id-1`] ?? false,
        items: [
          {
            title: 'Assistants',
            path: `/admin/global-prompt-library/prompts`,
          },
          {
            title: 'Categories',
            path: `/admin/global-prompt-library/categories`,
          },
        ],
      },
      {
        title: t("nav.system-config"),
        isOpened: navState[`admin-menu-id-2`] ?? false,
        items: [
          {
            title: t("nav.settings.instructions"),
            path: `/settings/instruction`,
          },
          {
            title: t("nav.settings.prompt-refinement"),
            path: `/settings/prompt-refinement`,
          },
        ],
      },
      {
        title: t("nav.reports"),
        isOpened: navState[`admin-menu-id-3`] ?? false,
        items: [
          {
            title: t("nav.usage-per-tenant"),
            path: `/reports/usage-per-tenant`,
          },
          {
            title: t("nav.credit-usage-all"),
            path: `/reports/credit-usage-all`,
          },
        ],
      },
    ],
  });
}

const modules = [...menuItems];
---

<nav
  class={`flex flex-col bg-base-100 min-h-screen gap-3 transition-all duration-300 ${isNavCollapsed ? "w-16" : "w-80"}`}
  id="main-navigation"
>
  <div class="mt-3 pl-6 flex items-center justify-between">
    <a href="/" class={isNavCollapsed ? "hidden" : ""}>
      <img
        src="/aibox-logo-text.svg"
        alt="Aibox Default Logo"
        class="h-8 block in-data-[theme=weihnachtsmann]:hidden in-data-[theme=somedia]:hidden in-data-[theme=light]:hidden in-data-[theme=dark]:hidden"
      />

      <img
        src="/logo-aibox-christmasedition.svg"
        alt="Weihnachtsmann Logo"
        class="h-8 hidden in-data-[theme=weihnachtsmann]:block"
      />
      <img
        src="/soki-somedia.png"
        alt="somedia Logo"
        class="h-8 hidden in-data-[theme=somedia]:block"
      />
      <img
        src="/aibox-logo-text.svg"
        alt="light logo"
        class="logo-light h-8 w-auto hidden in-data-[theme=light]:block"
      />
      <img
        src="/aibox-logo-text-dark.svg"
        alt="dark logo"
        class="logo-dark h-8 hidden in-data-[theme=dark]:block"
      />
    </a>

    <!-- Toggle Button -->
    <button
      id="nav-toggle-btn"
      class={`btn btn-ghost btn-sm btn-circle mr-6 hidden lg:flex ${isNavCollapsed ? "ml-2" : ""}`}
      aria-label={isNavCollapsed ? "Expand navigation" : "Collapse navigation"}
      title={isNavCollapsed ? "Expand navigation" : "Collapse navigation"}
      data-menu-open-icon={svgIcons.menuOpen}
      data-menu-close-icon={svgIcons.menuClose}
    >
      <div class="[&>svg]:h-4 [&>svg]:w-4">
        {
          isNavCollapsed ? (
            <Fragment set:html={svgIcons.menuOpen} />
          ) : (
            <Fragment set:html={svgIcons.menuClose} />
          )
        }
      </div>
    </button>
  </div>

  <div class="grow">
    <ul class={`menu w-full ${isNavCollapsed ? "pr-2" : "pr-6"}`}>
      <li class="active:bg-transparent">
        <details
          data-id={`ai-tools`}
          open={navState["ai-tools"] ?? true}
          id="onboardingId1"
          class="active:bg-transparent"
        >
          <summary
            class={isNavCollapsed
              ? "tooltip tooltip-right flex justify-center"
              : ""}
            data-tip={isNavCollapsed ? t("nav.text-prompts") : ""}
          >
            <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
              {svgIcons.aitool && <Fragment set:html={svgIcons.aitool} />}
            </div>
            <span class={isNavCollapsed ? "hidden" : ""}
              >{t("nav.text-prompts")}</span
            >
          </summary>
          <ul
            class={`w-full active:bg-transparent ${isNavCollapsed ? "hidden pr-2" : "pr-6"}`}
          >
            {
              modules.map((mod, index) => (
                <li class="active:bg-transparent">
                  <details
                    data-id={`ai-tools-module-${index}`}
                    open={mod.isOpened}
                    class="active:bg-transparent"
                  >
                    <summary>{mod.title}</summary>
                    {"items" in mod && (
                      <ul class="active:bg-transparent">
                        {mod.items?.map((sub) => (
                          <li class="pl-1 active:bg-transparent">
                            <MenuItem {...sub} />
                          </li>
                        ))}
                      </ul>
                    )}
                  </details>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
      {
        audioToTextMenus.length > 0 && (
          <div
            class={`mx-6 my-2 pointer-events-none ${isNavCollapsed ? "hidden" : ""}`}
          />
        )
      }
      {
        audioToTextMenus.map((mod) => (
          <li class="active:bg-transparent">
            <details
              data-id={`audio-menu`}
              open={mod.isOpened}
              id="onboardingId3"
              class="active:bg-transparent"
            >
              <summary
                class={
                  isNavCollapsed
                    ? "tooltip tooltip-right flex justify-center"
                    : ""
                }
                data-tip={isNavCollapsed ? mod.title : ""}
              >
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                <span class={isNavCollapsed ? "hidden" : ""}>{mod.title}</span>
              </summary>
              {"items" in mod && (
                <ul
                  class={`active:bg-transparent ${isNavCollapsed ? "hidden" : ""}`}
                >
                  {mod.items?.map((sub, id) => (
                    <li class="pl-1 active:bg-transparent">
                      {sub.items ? (
                        <details
                          data-id={`audio-menu-id-${id}`}
                          open={sub.isOpened}
                          class="active:bg-transparent"
                        >
                          <summary>{sub.title}</summary>
                          {sub.items.length > 0 && (
                            <ul class="active:bg-transparent">
                              {sub.items.map((sub1) => (
                                <li class="pl-1 active:bg-transparent">
                                  <MenuItem {...sub1} />
                                </li>
                              ))}
                            </ul>
                          )}
                        </details>
                      ) : (
                        <MenuItem {...sub} />
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </details>
          </li>
        ))
      }
      <div class="mx-6 my-2 pointer-events-none nav-spacer"></div>
      {
        subtitleStudioMenus.map((mod) => (
          <li class="active:bg-transparent">
            <details
              data-id={`subtitle-menu`}
              open={mod.isOpened}
              id="onboardingId5"
              class="active:bg-transparent"
            >
              <summary
                class={
                  isNavCollapsed
                    ? "tooltip tooltip-right flex justify-center"
                    : ""
                }
                data-tip={isNavCollapsed ? mod.title : ""}
              >
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                <span class={isNavCollapsed ? "hidden" : ""}>{mod.title}</span>
              </summary>
              {"items" in mod && (
                <ul
                  class={`active:bg-transparent ${isNavCollapsed ? "hidden" : ""}`}
                >
                  {mod.items?.map((sub, id) => (
                    <li class="pl-1 active:bg-transparent">
                      {sub.items ? (
                        <details
                          data-id={`subtitle-menu-id-${id}`}
                          open={sub.isOpened}
                          class="active:bg-transparent"
                        >
                          <summary>{sub.title}</summary>
                          {sub.items.length > 0 && (
                            <ul class="active:bg-transparent">
                              {sub.items.map((sub1) => (
                                <li class="pl-1 active:bg-transparent">
                                  <MenuItem {...sub1} />
                                </li>
                              ))}
                            </ul>
                          )}
                        </details>
                      ) : (
                        <MenuItem {...sub} />
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </details>
          </li>
        ))
      }

      {
        createImageMenus.length > 0 && (
          <div
            class={`mx-6 my-2 pointer-events-none ${isNavCollapsed ? "hidden" : ""}`}
          />
        )
      }
      {
        createImageMenus.map((mod) => (
          <li class="active:bg-transparent">
            <details
              data-id={`create-image`}
              open={mod.isOpened}
              class="active:bg-transparent"
              id="onboardingId4"
            >
              <summary
                class={
                  isNavCollapsed
                    ? "tooltip tooltip-right flex justify-center"
                    : ""
                }
                data-tip={isNavCollapsed ? mod.title : ""}
              >
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                <span class={isNavCollapsed ? "hidden" : ""}>{mod.title}</span>
              </summary>
              {"items" in mod && (
                <ul
                  class={`active:bg-transparent ${isNavCollapsed ? "hidden" : ""}`}
                >
                  {mod.items?.map((sub) => (
                    <li class="pl-1 active:bg-transparent">
                      <MenuItem {...sub} />
                    </li>
                  ))}
                </ul>
              )}
            </details>
          </li>
        ))
      }

      {
        myAIBoxMenus.length > 0 && (
          <div
            class={`mx-6 my-2 pointer-events-none ${isNavCollapsed ? "hidden" : ""}`}
          />
        )
      }
      {
        myAIBoxMenus.map((mod, index) => (
          <li class="active:bg-transparent w-full">
            <details
              data-id={"my-ai-box"}
              open={mod.isOpened}
              class="active:bg-transparent w-full"
            >
              <summary
                class={
                  isNavCollapsed
                    ? "tooltip tooltip-right flex justify-center"
                    : ""
                }
                data-tip={isNavCollapsed ? mod.title : ""}
              >
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                <span class={isNavCollapsed ? "hidden" : ""}>{mod.title}</span>
              </summary>
              <ConversationItems
                conversations={transformRawData(conversations)}
                routePath={Astro.url.pathname}
                isCollapsed={isNavCollapsed}
                client:idle
              />
            </details>
            {index < myAIBoxMenus.length - 1 && (
              <div
                class={`mx-6 my-1 pointer-events-none ${isNavCollapsed ? "hidden" : ""}`}
              />
            )}
          </li>
        ))
      }

      {
        adminMenus.length > 0 && (
          <div
            class={`mx-6 my-2 pointer-events-none ${isNavCollapsed ? "hidden" : ""}`}
          />
        )
      }
      {
        adminMenus.map((mod, index) => (
          <li class="active:bg-transparent">
            <details
              data-id={`admin-menu`}
              open={mod.isOpened}
              class="active:bg-transparent"
              id="onboardingNewTenantId1"
            >
              <summary
                class={
                  isNavCollapsed
                    ? "tooltip tooltip-right flex justify-center"
                    : ""
                }
                data-tip={isNavCollapsed ? mod.title : ""}
              >
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                <span class={isNavCollapsed ? "hidden" : ""}>{mod.title}</span>
              </summary>
              {"items" in mod && (
                <ul
                  class={`active:bg-transparent ${isNavCollapsed ? "hidden" : ""}`}
                >
                  {mod.items?.map((sub) => (
                    <li class="pl-1 active:bg-transparent">
                      <MenuItem {...sub} />
                    </li>
                  ))}
                </ul>
              )}
            </details>
            {index < adminMenus.length - 1 && (
              <div
                class={`mx-6 my-1 pointer-events-none ${isNavCollapsed ? "hidden" : ""}`}
              />
            )}
          </li>
        ))
      }

      {
        supperAdminMenus.length > 0 && (
          <div
            class={`divider mx-6 pointer-events-none ${isNavCollapsed ? "hidden" : ""}`}
          />
        )
      }
      {
        supperAdminMenus.map((mod, index) => (
          <li class="active:bg-transparent">
            <details
              data-id={`supper-admin-menu`}
              open={mod.isOpened}
              class="active:bg-transparent"
            >
              <summary
                class={
                  isNavCollapsed
                    ? "tooltip tooltip-right flex justify-center"
                    : ""
                }
                data-tip={isNavCollapsed ? mod.title : ""}
              >
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                <span class={isNavCollapsed ? "hidden" : ""}>{mod.title}</span>
              </summary>
              {"items" in mod && (
                <ul
                  class={`active:bg-transparent ${isNavCollapsed ? "hidden" : ""}`}
                >
                  {mod.items?.map((sub, _index) => (
                    <li class="pl-1 active:bg-transparent">
                      {sub.items ? (
                        <details
                          data-id={`admin-menu-id-${_index}`}
                          open={sub.isOpened}
                          class="active:bg-transparent"
                        >
                          <summary>{sub.title}</summary>
                          {sub.items.length > 0 && (
                            <ul class="active:bg-transparent">
                              {sub.items.map((sub1) => (
                                <li class="pl-1 active:bg-transparent">
                                  <MenuItem {...sub1} />
                                </li>
                              ))}
                            </ul>
                          )}
                        </details>
                      ) : (
                        <MenuItem {...sub} />
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </details>
            {index < supperAdminMenus.length - 1 && (
              <div
                class={`mx-6 my-1 pointer-events-none ${isNavCollapsed ? "hidden" : ""}`}
              />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script type="module">
  if (!window.__NAVIGATION_INITIALIZED__) {
    window.__NAVIGATION_INITIALIZED__ = true;

    async function updateNavState(detailsId, isOpen) {
      try {
        await fetch("/api/users/update-nav-state.json", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: detailsId, open: isOpen }),
        });
      } catch (err) {
        console.warn("[Navigation] Failed to update nav state:", err);
      }
    }

    function applyOpenStates() {
      const detailsElements = document.querySelectorAll("details[data-id]");
      for (const element of detailsElements) {
        const detailsId = element.dataset.id;
        if (!detailsId) continue;

        element.addEventListener(
          "toggle",
          () => updateNavState(detailsId, element.open),
          { passive: true }
        );
      }
    }

    function toggleNavigation(expand) {
      const navigation = document.getElementById("main-navigation");
      const toggleBtn = document.getElementById("nav-toggle-btn");
      if (!navigation || !toggleBtn) return;

      const collapsed = navigation.classList.contains("w-16");
      const newCollapsed = expand !== undefined ? !expand : !collapsed;

      // Update DB state (non-blocking)
      updateNavState("nav-collapsed", newCollapsed);

      // Toggle nav width
      navigation.classList.toggle("w-80", !newCollapsed);
      navigation.classList.toggle("w-16", newCollapsed);

      // Handle visibility of elements
      const selectorGroups = {
        logo: navigation.querySelector('a[href="/"]'),
        textSpans: navigation.querySelectorAll("span:not(.tooltip)"),
        subMenus: navigation.querySelectorAll("ul ul"),
        spacers: navigation.querySelectorAll(".mx-6.my-2, .mx-6.my-1"),
        summaries: navigation.querySelectorAll("details > summary"),
        menuElement: navigation.querySelector(".menu"),
      };

      if (selectorGroups.logo)
        selectorGroups.logo.classList.toggle("hidden", newCollapsed);

      selectorGroups.textSpans.forEach((el) =>
        el.classList.toggle("hidden", newCollapsed)
      );
      selectorGroups.subMenus.forEach((el) =>
        el.classList.toggle("hidden", newCollapsed)
      );
      selectorGroups.spacers.forEach((el) =>
        el.classList.toggle("hidden", newCollapsed)
      );

      selectorGroups.summaries.forEach((summary) => {
        summary.classList.toggle("tooltip", newCollapsed);
        summary.classList.toggle("tooltip-right", newCollapsed);
        summary.classList.toggle("flex", newCollapsed);
        summary.classList.toggle("justify-center", newCollapsed);
      });

      if (selectorGroups.menuElement) {
        selectorGroups.menuElement.classList.toggle("pr-6", !newCollapsed);
        selectorGroups.menuElement.classList.toggle("pr-2", newCollapsed);
      }

      // Update accessibility labels
      toggleBtn.setAttribute(
        "aria-label",
        newCollapsed ? "Expand navigation" : "Collapse navigation"
      );
      toggleBtn.setAttribute(
        "title",
        newCollapsed ? "Expand navigation" : "Collapse navigation"
      );

      // Update icon
      const iconContainer = toggleBtn.querySelector("div");
      if (iconContainer) {
        const openIcon =
          toggleBtn.dataset.menuOpenIcon ||
          `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>`;
        const closeIcon =
          toggleBtn.dataset.menuCloseIcon ||
          `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>`;
        iconContainer.innerHTML = newCollapsed ? openIcon : closeIcon;
      }
    }

    function setupNavToggle() {
      const toggleBtn = document.getElementById("nav-toggle-btn");
      if (!toggleBtn) return;

      toggleBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        toggleNavigation();
      });
    }

    function setupCollapsedMenuClicks() {
      const navigation = document.getElementById("main-navigation");
      if (!navigation) return;

      const summaries = navigation.querySelectorAll("details > summary");
      for (const summary of summaries) {
        summary.addEventListener("click", (e) => {
          if (navigation.classList.contains("w-16")) {
            e.preventDefault();
            e.stopPropagation();
            toggleNavigation(true);
          }
        });
      }
    }

    document.addEventListener("astro:page-load", () => {
      applyOpenStates();
      setupNavToggle();
      setupCollapsedMenuClicks();
    });
  }
</script>
