---
import { useTranslations } from "$i18n/utils";
import MenuItem from "./MenuItem.astro";
import Category from "$data/models/category.model";
import { AudioCategory, TenantFeature } from "$types/TenantFeature";
import { TranscriptionType } from "$types/TranscribeRequest";
import { svgIcons } from "$assets/icons";
import auth from "$auth/auth";
import { ApiKeyProvider } from "$types/TenantFeature";
import TranscriptionModel from "$data/models/transcription.model";

const t = useTranslations();

const cursor = await Category.listActiveByTenant(Astro.locals.user.tenant_id);
const categories = await cursor.toArray();

const navState = Astro.locals.user.navState || {};

const menuItems = categories.map((category, index) => ({
  title: category.title,
  icon: category.icon,
  isOpened: navState[`ai-tools-module-${index}`] ?? false,
  items: category.groups
    ?.filter((group) => {
      return group?.active && group.active == true;
    })
    .map((group) => ({
      title: group.title,
      path: `/prompts/${category._id}/${group._id}`,
    })),
}));

const audioToTextMenus = [];
const audioFeatureItems = [];

const createImageMenus = [];
const createImageItems = [];

const transcriptions = await TranscriptionModel.listByTenant(
  Astro.locals.user.tenant_id,
);

const transcriptionTypes = Astro.locals.tenant.transcription_types ?? [];

const activeTranscriptions =
  transcriptions?.filter(
    (tran) =>
      transcriptionTypes.includes(tran.category) && tran.enabled === true,
  ) ?? [];

const audioToTextTranscriptions = activeTranscriptions
  .filter((tran) => tran.category == AudioCategory.AudioToText)
  .map((tran) => ({
    title: tran.name,
    path: `/transcription/${tran._id.toString()}`,
    usecaseId: tran._id.toString(),
  }));

const subtitleTranscriptions = activeTranscriptions
  .filter(
    (tran) =>
      tran.category == AudioCategory.Subtitle ||
      tran.category == AudioCategory.SubtitleJson ||
      tran.category == AudioCategory.SubtitleLarge,
  )
  .map((tran) => ({
    title: tran.name,
    path: `/transcription/${tran._id.toString()}`,
    usecaseId: tran._id.toString(),
  }));

if (audioToTextTranscriptions.length > 0) {
  audioFeatureItems.push({
    title: t("nav.audiotool.audio-to-text"),
    isOpened: navState["audio-menu-id-0"] ?? false,
    items: audioToTextTranscriptions,
  });
}

if (subtitleTranscriptions.length > 0) {
  audioFeatureItems.push({
    title: t("settings.transcription.subtitles-title"),
    isOpened: navState["audio-menu-id-1"] ?? false,
    items: subtitleTranscriptions,
  });
}

if (transcriptionTypes.includes(AudioCategory.AudioPro)) {
  audioFeatureItems.push({
    title: t("settings.transcription.largefile-title"),
    path: `/transcription/${TranscriptionType.Largefile}`,
    transcriptionType: TranscriptionType.Largefile,
  });
}

if (audioFeatureItems.length > 0) {
  audioToTextMenus.push({
    title: t("nav.audiotool"),
    icon: svgIcons.audio,
    isOpened: navState["audio-menu"] ?? false,
    items: audioFeatureItems,
  });
}

if (
  auth.hasFeatureWithProvider(
    Astro.locals,
    TenantFeature.CreateImage,
    ApiKeyProvider.OpenAI,
  )
) {
  createImageItems.push({
    title: t("nav.create-image.dall-e"),
    path: "/create-image/openai",
  });
}
if (
  auth.hasFeatureWithProvider(
    Astro.locals,
    TenantFeature.CreateImage,
    ApiKeyProvider.Flux,
  )
) {
  createImageItems.push({
    title: t("nav.create-image.flux"),
    path: "/create-image/flux",
  });
}

if (createImageItems.length > 0) {
  createImageMenus.push({
    title: t("nav.create-image"),
    icon: svgIcons.image,
    isOpened: navState["create-image"] ?? false,
    items: createImageItems,
  });
}

const restrictedMenus = [];
const settingsItems = [
  {
    title: t("nav.settings.prompts"),
    path: "/prompt-library/prompts",
  },
  {
    title: t("nav.settings.knowledge-base"),
    path: "/prompt-library/knowledge-base",
  },
  {
    title: t("nav.settings.categories"),
    path: "/prompt-library/categories",
  },
];

if (auth.hasFeature(Astro.locals, TenantFeature.AudioToText)) {
  settingsItems.push({
    title: t("nav.settings.audio"),
    path: "/settings/transcription",
  });
}

if (auth.isAdmin(Astro.locals) || auth.isSuperAdmin(Astro.locals)) {
  settingsItems.push({
    title: t("user.user-management"),
    path: "/user-management",
  });
  restrictedMenus.push({
    title: t("nav.settings"),
    icon: svgIcons.menuSettings,
    isOpened: navState[`restricted-menu-0`] ?? false,
    items: settingsItems,
  });
}

if (auth.isSuperAdmin(Astro.locals)) {
  restrictedMenus.push({
    title: t("nav.settings.admin"),
    icon: svgIcons.admin,
    isOpened: navState[`restricted-menu-1`] ?? false,
    items: [
      {
        title: t("nav.tenant-management"),
        path: `/tenant-management`,
      },
      {
        title: t("nav.usage"),
        path: `/usage`,
      },
    ],
  });
}

const modules = [...menuItems];
---

<nav class="flex flex-col bg-base-100 w-80 min-h-screen gap-6">
  <div class="mt-4 pl-6">
    <a href="/">
      <img
        src="/aibox-logo-text.svg"
        alt="Aibox Default Logo"
        class="h-8 block in-data-[theme=weihnachtsmann]:hidden in-data-[theme=somedia]:hidden in-data-[theme=light]:hidden in-data-[theme=dark]:hidden"
      />

      <img
        src="/logo-aibox-christmasedition.svg"
        alt="Weihnachtsmann Logo"
        class="h-8 hidden in-data-[theme=weihnachtsmann]:block"
      />
      <img
        src="/soki-somedia.png"
        alt="somedia Logo"
        class="h-8 hidden in-data-[theme=somedia]:block"
      />
      <img
        src="/aibox-logo-text.svg"
        alt="light logo"
        class="logo-light h-8 w-auto hidden in-data-[theme=light]:block"
      />
      <img
        src="/aibox-logo-text-dark.svg"
        alt="dark logo"
        class="logo-dark h-8 hidden in-data-[theme=dark]:block"
      />
    </a>
  </div>

  <div class="grow">
    <ul class="menu w-full pr-6">
      <li class="active:bg-transparent">
        <details
          data-id={`ai-tools`}
          open={navState["ai-tools"] ?? true}
          id="onboardingId1"
          class="active:bg-transparent"
        >
          <summary>
            <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
              {svgIcons.aitool && <Fragment set:html={svgIcons.aitool} />}
            </div>
            {t("nav.text-prompts")}
          </summary>
          <ul class="w-full pr-6 active:bg-transparent">
            {
              modules.map((mod, index) => (
                <li class="active:bg-transparent">
                  <details
                    data-id={`ai-tools-module-${index}`}
                    open={mod.isOpened}
                    class="active:bg-transparent"
                  >
                    <summary>{mod.title}</summary>
                    {"items" in mod && (
                      <ul class="active:bg-transparent">
                        {mod.items?.map((sub) => (
                          <li class="pl-1 active:bg-transparent">
                            <MenuItem {...sub} />
                          </li>
                        ))}
                      </ul>
                    )}
                  </details>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
      {
        audioToTextMenus.length > 0 && (
          <div class="divider mx-6 pointer-events-none" />
        )
      }
      {
        audioToTextMenus.map((mod) => (
          <li class="active:bg-transparent">
            <details
              data-id={`audio-menu`}
              open={mod.isOpened}
              id="onboardingId3"
              class="active:bg-transparent"
            >
              <summary>
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                {mod.title}
              </summary>
              {"items" in mod && (
                <ul class="active:bg-transparent">
                  {mod.items?.map((sub, id) => (
                    <li class="pl-1 active:bg-transparent">
                      {sub.items ? (
                        <details
                          data-id={`audio-menu-id-${id}`}
                          open={sub.isOpened}
                          class="active:bg-transparent"
                        >
                          <summary>{sub.title}</summary>
                          {sub.items.length > 0 && (
                            <ul class="active:bg-transparent">
                              {sub.items.map((sub1) => (
                                <li class="pl-1 active:bg-transparent">
                                  <MenuItem {...sub1} />
                                </li>
                              ))}
                            </ul>
                          )}
                        </details>
                      ) : (
                        <MenuItem {...sub} />
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </details>
          </li>
        ))
      }

      {
        createImageMenus.length > 0 && (
          <div class="divider mx-6 pointer-events-none" />
        )
      }
      {
        createImageMenus.map((mod) => (
          <li class="active:bg-transparent">
            <details
              data-id={`create-image`}
              open={mod.isOpened}
              class="active:bg-transparent"
              id="onboardingId4"
            >
              <summary>
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                {mod.title}
              </summary>
              {"items" in mod && (
                <ul class="active:bg-transparent">
                  {mod.items?.map((sub) => (
                    <li class="pl-1 active:bg-transparent">
                      <MenuItem {...sub} />
                    </li>
                  ))}
                </ul>
              )}
            </details>
          </li>
        ))
      }

      {
        restrictedMenus.length > 0 && (
          <div class="divider mx-6 pointer-events-none" />
        )
      }
      {
        restrictedMenus.map((mod, index) => (
          <li class="active:bg-transparent">
            <details
              data-id={`restricted-menu-${index}`}
              open={mod.isOpened}
              class="active:bg-transparent"
              id="onboardingId5"
            >
              <summary>
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                {mod.title}
              </summary>
              {"items" in mod && (
                <ul class="active:bg-transparent">
                  {mod.items?.map((sub) => (
                    <li class="pl-1 active:bg-transparent">
                      <MenuItem {...sub} />
                    </li>
                  ))}
                </ul>
              )}
            </details>
            {index < restrictedMenus.length - 1 && (
              <div class="divider pointer-events-none" />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  function applyOpenStates() {
    const detailsElements = document.querySelectorAll("details[data-id]");
    detailsElements.forEach((element) => {
      const details = element as HTMLDetailsElement;
      const detailsId = details.getAttribute("data-id") || "";
      details.addEventListener("toggle", () => {
        updateNavState(detailsId, details.open);
      });
    });
  }

  async function updateNavState(detailsId: string, isOpen: boolean) {
    await fetch("/api/user/update-nav-state.json", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id: detailsId, open: isOpen }),
    });
  }

  // Ensure open states are applied after page load
  document.addEventListener("astro:page-load", () => {
    applyOpenStates();
  });
</script>
