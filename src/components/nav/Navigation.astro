---
import { useTranslations } from "$i18n/utils";
import MenuItem from "./MenuItem.astro";

import Icon, { Name } from "./icons/Icon.astro";

const t = useTranslations(Astro.preferredLocale);

const modules = [
  {
    title: t("nav.text-writing"),
    icon: Name.Writing,
    items: [
      {
        title: "Headline",
        path: "/headlines",
      },
      {
        title: "Headline UI Demo",
        path: "/headlines/demo",
      },
      {
        title: "Summarize",
        path: "/summarize",
      },
      {
        title: "Shorten test",
        path: "/shorten-text",
      },
      {
        title: "Police Report",
        path: "/police-report",
      },
    ],
  },
  {
    title: t("nav.settings"),
    icon: Name.Settings,
    items: [
      {
        title: t("nav.settings.prompts"),
        path: "/prompts",
      },
      {
        title: t("nav.settings.knowledge-base"),
        path: "/knowledge-base",
      },
      {
        title: t("nav.settings.categories"),
        path: "/categories",
      },
    ],
  },
];
---

<nav class="flex flex-col bg-base-100 w-80 h-full">
  <div>
    <div class="text-sm pl-6 pt-5 flex flex-row items-center gap-2">
      <Icon icon={Name.Apps} class="w-4 h-4" />
      <span>{t("nav.all-widgets")}</span>
    </div>
    <ul class="menu w-full pr-6">
      {
        modules.map((mod) => (
          <>
            <li>
              <div class="border-t-base-content border-t rounded-none mt-4 ml-4 h-0 opacity-20" />
            </li>
            <li>
              <MenuItem {...mod}>
                <Icon icon={mod.icon} class="w-4 h-4" slot="icon" />
              </MenuItem>

              {"items" in mod && (
                <ul>
                  {mod.items.map((sub) => (
                    <li>
                      <MenuItem {...sub} />
                    </li>
                  ))}
                </ul>
              )}
            </li>
          </>
        ))
      }
    </ul>
  </div>
</nav>
