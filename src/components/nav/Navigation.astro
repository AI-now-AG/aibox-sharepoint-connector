---
import MenuItem from "./MenuItem.astro";

import AppsIcon from "./icons/Apps.astro";
import WritingIcon from "./icons/Writing.astro";

const modules = [
  {
    title: "Text writing",
    items: [
      {
        title: "Headline",
        path: "/headlines",
      },
      {
        title: "Summarize",
        path: "/summarize",
      },
      {
        title: "Rewrite",
        path: "/rewrite",
      },
    ],
  },
];
---


<nav class="min-h-full flex flex-col bg-base-200">
  <div>
    <div class="text-lg pl-4 py-4 flex flex-row items-center">
      <AppsIcon class="w-8 h-8 mr-1" />
      Apps
    </div>
    <ul class="menu w-64">
      {
        modules.map((mod) => (
          <li>
            <MenuItem {...mod}>
              <WritingIcon slot="icon" />
            </MenuItem>

            {"items" in mod && (
              <ul>
                {mod.items.map((sub) => (
                  <li>
                    <MenuItem {...sub} />
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</nav>
