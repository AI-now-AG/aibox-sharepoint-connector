---
import { useTranslations } from "$i18n/utils";
import MenuItem from "./MenuItem.astro";
import Category from "$data/models/category.model";
import { TenantFeature } from "$data/models/tenant.model";
import { svgIcons } from "$assets/icons";
import auth from "$auth/auth";

const t = useTranslations();

const cursor = await Category.listByTenant(Astro.locals.user.tenant_id);
const categories = await cursor.toArray();

const menuItems = categories.map((category) => ({
  title: category.title,
  icon: category.icon,
  items: category.groups?.map((group) => ({
    title: group.title,
    path: `/prompts/${category._id}/${group._id}`,
  })),
}));

if (auth.hasFeature(Astro.locals, TenantFeature.AudioToText)) {
  menuItems.push({
    title: t("nav.transcription"),
    icon: svgIcons.transcription,
    items: [
      {
        title: t("nav.transcription.audio-to-text"),
        path: `/transcription`,
      },
    ],
  });
}

// TODO: Check logic supper admin here
const tenantMenuItem = auth.isSuperAdmin(Astro.locals)
  ? {
      title: t("nav.tenant-management"),
      icon: svgIcons.menuTenant,
      path: "/tenant-management",
    }
  : undefined;

// Settings area
const settingItem =  {
    title: t("nav.settings"),
    icon: svgIcons.menuSettings,
    items: [
      {
        title: t("nav.settings.prompts"),
        path: "/prompt-library/prompts",
      },
      {
        title: t("nav.settings.instructions"),
        path: "/prompt-library/instructions",
      },
      {
        title: t("nav.settings.knowledge-base"),
        path: "/prompt-library/knowledge-base",
      },
      {
        title: t("nav.settings.categories"),
        path: "/prompt-library/categories",
      },
    ],
  };

// Settings > Transcription
if (auth.hasFeature(Astro.locals, TenantFeature.AudioToText)) {
  settingItem['items'].push({
    title: t("nav.settings.transcription"),
    path: "/settings/transcription",
  });
}

const modules = [
  ...menuItems,
  ...[settingItem],
];
---

<nav class="flex flex-col bg-base-100 w-80 min-h-screen gap-6">
  <div class="mt-4 pl-6">
    <a href="/">
      <img
        src="/soki-somedia.png"
        alt="Somedia Logo"
        class="h-8 logo-somedia"
      />
      <!-- light/dark mode doesn't work currently in the way themes are implemented. Currently only the light variant will be rendered -->
      <img
        src="/aibox-logo-text.svg"
        class="logo-light h-8 w-auto dark:hidden"
      />
      <img src="/aibox-logo-text-dark.svg" class="logo-dark h-8 dark:block" />
    </a>
  </div>
  <div>
    <!--<div class="text-sm pl-6 pt-5 flex flex-row items-center gap-2">
      <Icon icon={Name.Apps} class="w-4 h-4" />
      <span>{t("nav.all-widgets")}</span>
    </div>-->
    <ul class="menu w-full pr-6">
      {
        modules.map((mod) => (
          <li class="">
            <details open>
              <summary>
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                {mod.title}
              </summary>

              {"items" in mod && (
                <ul>
                  {mod.items?.map((sub) => (
                    <li class="pl-1">
                      <MenuItem {...sub} />
                    </li>
                  ))}
                </ul>
              )}
            </details>
          </li>
        ))
      }

      {
        tenantMenuItem ? (
          <li class="pl-1">
            <MenuItem
              title={tenantMenuItem.title}
              path={tenantMenuItem.path}
              icon={tenantMenuItem.icon}
            />
          </li>
        ) : null
      }
    </ul>
  </div>
</nav>
