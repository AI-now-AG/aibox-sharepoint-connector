---
import { useTranslations } from "$i18n/utils";
import MenuItem from "./MenuItem.astro";
import Category from "$data/models/category.model";
import { TenantFeature } from "$data/models/tenant.model";
import { svgIcons } from "$assets/icons";
import auth from "$auth/auth";

const t = useTranslations();

const cursor = await Category.listByTenant(Astro.locals.user.tenant_id);
const categories = await cursor.toArray();

const menuItems = categories.map((category) => ({
  title: category.title,
  icon: category.icon,
  items: category.groups?.map((group) => ({
    title: group.title,
    path: `/prompts/${category._id}/${group._id}`,
  })),
}));

if (auth.hasFeature(Astro.locals, TenantFeature.AudioToText)) {
  menuItems.push({
    title: t("nav.transcription"),
    icon: svgIcons.transcription,
    items: [
      {
        title: t("nav.transcription.audio-to-text"),
        path: `/transcription`,
      },
    ],
  });
}

// TODO: Check logic supper admin here
const tenantMenuItem = auth.isSuperAdmin(Astro.locals)
  ? {
      title: t("nav.tenant-management"),
      icon: svgIcons.tenantManagement,
      path: "/tenant-management",
    }
  : undefined;

  const settingItem =  {
    title: t("nav.settings"),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
	<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" color="currentColor">
		<path d="M16.308 4.384c-.59 0-.886 0-1.155-.1l-.111-.046c-.261-.12-.47-.328-.888-.746c-.962-.962-1.443-1.443-2.034-1.488a2 2 0 0 0-.24 0c-.591.045-1.072.526-2.034 1.488c-.418.418-.627.627-.888.746l-.11.046c-.27.1-.565.1-1.156.1h-.11c-1.507 0-2.261 0-2.73.468s-.468 1.223-.468 2.73v.11c0 .59 0 .886-.1 1.155q-.022.057-.046.111c-.12.261-.328.47-.746.888c-.962.962-1.443 1.443-1.488 2.034a2 2 0 0 0 0 .24c.045.591.526 1.072 1.488 2.034c.418.418.627.627.746.888q.025.054.046.11c.1.27.1.565.1 1.156v.11c0 1.507 0 2.261.468 2.73s1.223.468 2.73.468h.11c.59 0 .886 0 1.155.1q.057.021.111.046c.261.12.47.328.888.746c.962.962 1.443 1.443 2.034 1.488q.12.009.24 0c.591-.045 1.072-.526 2.034-1.488c.418-.418.627-.626.888-.746q.054-.025.11-.046c.27-.1.565-.1 1.156-.1h.11c1.507 0 2.261 0 2.73-.468s.468-1.223.468-2.73v-.11c0-.59 0-.886.1-1.155q.021-.057.046-.111c.12-.261.328-.47.746-.888c.962-.962 1.443-1.443 1.488-2.034q.009-.12 0-.24c-.045-.591-.526-1.072-1.488-2.034c-.418-.418-.626-.627-.746-.888l-.046-.11c-.1-.27-.1-.565-.1-1.156v-.11c0-1.507 0-2.261-.468-2.73s-1.223-.468-2.73-.468z" />
		<path d="M15.5 12a3.5 3.5 0 1 1-7 0a3.5 3.5 0 0 1 7 0" />
	</g>
</svg>`,
    items: [
      {
        title: t("nav.settings.prompts"),
        path: "/prompt-library/prompts",
      },
      {
        title: t("nav.settings.instructions"),
        path: "/prompt-library/instructions",
      },
      {
        title: t("nav.settings.knowledge-base"),
        path: "/prompt-library/knowledge-base",
      },
      {
        title: t("nav.settings.categories"),
        path: "/prompt-library/categories",
      },
    ],
  };

if (auth.hasFeature(Astro.locals, TenantFeature.AudioToText)) {
  settingItem['items'].push({
    title: t("nav.settings.transcription"),
    path: "/settings/transcription",
  });
}

const modules = [
  ...menuItems,
  ...[settingItem],
];
---

<nav class="flex flex-col bg-base-100 w-80 min-h-screen gap-6">
  <div class="mt-4 pl-6">
    <a href="/">
      <img
        src="/soki-somedia.png"
        alt="Somedia Logo"
        class="h-8 logo-somedia"
      />
      <!-- light/dark mode doesn't work currently in the way themes are implemented. Currently only the light variant will be rendered -->
      <img
        src="/aibox-logo-text.svg"
        class="logo-light h-8 w-auto dark:hidden"
      />
      <img src="/aibox-logo-text-dark.svg" class="logo-dark h-8 dark:block" />
    </a>
  </div>
  <div>
    <!--<div class="text-sm pl-6 pt-5 flex flex-row items-center gap-2">
      <Icon icon={Name.Apps} class="w-4 h-4" />
      <span>{t("nav.all-widgets")}</span>
    </div>-->
    <ul class="menu w-full pr-6">
      {
        modules.map((mod) => (
          <li class="">
            <details open>
              <summary>
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                {mod.title}
              </summary>

              {"items" in mod && (
                <ul>
                  {mod.items?.map((sub) => (
                    <li class="pl-1">
                      <MenuItem {...sub} />
                    </li>
                  ))}
                </ul>
              )}
            </details>
          </li>
        ))
      }

      {
        tenantMenuItem ? (
          <li class="pl-1">
            <MenuItem
              title={tenantMenuItem.title}
              path={tenantMenuItem.path}
              icon={tenantMenuItem.icon}
            />
          </li>
        ) : null
      }
    </ul>
  </div>
</nav>
