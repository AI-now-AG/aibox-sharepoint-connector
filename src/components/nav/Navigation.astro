---
import { useTranslations } from "$i18n/utils";
import MenuItem from "./MenuItem.astro";
import Category from "$data/models/category.model";
import { TenantFeature } from "$data/models/tenant.model";
import { svgIcons } from "$assets/icons";
import auth from "$auth/auth";

const t = useTranslations();

const cursor = await Category.listByTenant(Astro.locals.user.tenant_id);
const categories = await cursor.toArray();

const menuItems = categories.map((category) => ({
  title: category.title,
  icon: category.icon,
  items: category.groups?.map((group) => ({
    title: group.title,
    path: `/prompts/${category._id}/${group._id}`,
  })),
}));

const audioToTextMenus = [];
if (auth.hasFeature(Astro.locals, TenantFeature.AudioToText)) {
  audioToTextMenus.push({
    title: t("nav.audiotool"),
    icon: svgIcons.audio,
    items: [
      {
        title: t("nav.audiotool.audio-to-text"),
        path: `/transcription`,
      },
    ],
  });
}

const restrictedMenus = [];
const settingsItems = [
  {
    title: t("nav.settings.prompts"),
    path: "/prompt-library/prompts",
  },
  {
    title: t("nav.settings.knowledge-base"),
    path: "/prompt-library/knowledge-base",
  },
  {
    title: t("nav.settings.categories"),
    path: "/prompt-library/categories",
  },
];

if (auth.hasFeature(Astro.locals, TenantFeature.AudioToText)) {
  settingsItems.push({
    title: t("tenant.audio-to-text"),
    path: "/settings/transcription",
  });
}

if (auth.isAdmin(Astro.locals) || auth.isSuperAdmin(Astro.locals)) {
  restrictedMenus.push({
    title: t("nav.settings"),
    icon: svgIcons.menuSettings,
    items: settingsItems,
  });
}

if (auth.isSuperAdmin(Astro.locals)) {
  restrictedMenus.push({
    title: t("nav.settings.admin"),
    icon: svgIcons.admin,
    items: [
      {
        title: t("nav.tenant-management"),
        path: `/tenant-management`,
      },
    ],
  });
}

// // TODO: Check logic supper admin here
// const tenantMenuItem = auth.isSuperAdmin(Astro.locals)
//   ? {
//       title: t("nav.tenant-management"),
//       icon: svgIcons.tenantManagement,
//       path: "/tenant-management",
//     }
//   : undefined;

const modules = [
  /*{
    title: t("nav.text-writing"),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
	<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" color="currentColor">
		<path d="M10.55 3c-3.852.007-5.87.102-7.159 1.39C2 5.783 2 8.022 2 12.5s0 6.717 1.391 8.109C4.783 22 7.021 22 11.501 22c4.478 0 6.717 0 8.108-1.391c1.29-1.29 1.384-3.307 1.391-7.16" />
		<path d="M11.056 13C10.332 3.866 16.802 1.276 21.98 2.164c.209 3.027-1.273 4.16-4.093 4.684c.545.57 1.507 1.286 1.403 2.18c-.074.638-.506.95-1.372 1.576c-1.896 1.37-4.093 2.234-6.863 2.396" />
		<path d="M9 17c2-5.5 3.96-7.364 6-9" />
	</g>
</svg>`,
    items: [
      {
        title: "Headline",
        path: "/headlines",
      },
      {
        title: "Headline UI Demo",
        path: "/headlines/demo",
      },
      {
        title: "Summarize",
        path: "/summarize",
      },
      {
        title: "Shorten test",
        path: "/shorten-text",
      },
      {
        title: "Police Report",
        path: "/police-report",
      },
    ],
  },*/
  ...menuItems,
];
---

<nav class="flex flex-col bg-base-100 w-80 min-h-screen gap-6">
  <div class="mt-4 pl-6">
    <a href="/">
      <img
        src="/soki-somedia.png"
        alt="somedia Logo"
        class="h-8 hidden [[data-theme=somedia]_&]:block"
      />
      <img
        src="/aibox-logo-text.svg"
        alt="light logo"
        class="logo-light h-8 w-auto hidden [[data-theme=light]_&]:block"
      />
      <img
        src="/aibox-logo-text-dark.svg"
        alt="dark logo"
        class="logo-dark h-8 hidden [[data-theme=dark]_&]:block"
      />
    </a>
  </div>

  <div class="flex-grow">
    <ul class="menu w-full pr-6">
      <li>
        <details data-id={`ai-tools`}>
          <summary>
            <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
              {svgIcons.aitool && <Fragment set:html={svgIcons.aitool} />}
            </div>
            KI ANWENDUNGEN
          </summary>
          <ul class="menu w-full pr-6">
            {
              modules.map((mod, index) => (
                <li class="">
                  <details data-id={`ai-tools-module-${index}`}>
                    <summary>
                      {/* <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                        {mod.icon && <Fragment set:html={mod.icon} />}
                      </div> */}
                      {mod.title}
                    </summary>
                    {"items" in mod && (
                      <ul>
                        {mod.items?.map((sub) => (
                          <li class="pl-1">
                            <MenuItem {...sub} />
                          </li>
                        ))}
                      </ul>
                    )}
                  </details>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
    </ul>
    <ul class="menu w-full pr-6">
      {
        audioToTextMenus.length > 0 && (
          <div class="divider mx-6 pointer-events-none" />
        )
      }
      {
        audioToTextMenus.map((mod) => (
          <li class="">
            <details data-id={`audio-menu`}>
              <summary>
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                {mod.title}
              </summary>
              {"items" in mod && (
                <ul>
                  {mod.items?.map((sub) => (
                    <li class="pl-1">
                      <MenuItem {...sub} />
                    </li>
                  ))}
                </ul>
              )}
            </details>
          </li>
        ))
      }
      {
        restrictedMenus.length > 0 && (
          <div class="divider mx-6 pointer-events-none" />
        )
      }
      {
        restrictedMenus.map((mod, index) => (
          <li>
            <details data-id={`restricted-menu-${index}`}>
              <summary>
                <div slot="icon" class="[&>svg]:h-5 [&>svg]:w-5">
                  {mod.icon && <Fragment set:html={mod.icon} />}
                </div>
                {mod.title}
              </summary>
              {"items" in mod && (
                <ul>
                  {mod.items?.map((sub) => (
                    <li class="pl-1">
                      <MenuItem {...sub} />
                    </li>
                  ))}
                </ul>
              )}
            </details>
            {index < restrictedMenus.length - 1 && (
              <div class="divider pointer-events-none" />
            )}
          </li>
        ))
      }
    </ul>
  </div>
  <!-- Settings and Admin items aligned at the bottom -->
  <!-- <div class="mt-auto">
    <ul class="menu w-full pr-6">
    </ul>
  </div> -->
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const detailsElements = document.querySelectorAll("details[data-id]");
    detailsElements.forEach((element) => {
      const details = element as HTMLDetailsElement; // Type casting to HTMLDetailsElement
      const state = localStorage.getItem(details.getAttribute("data-id") || "");
      details.open = state === "true";
      
      details.addEventListener("toggle", () => {
        localStorage.setItem(
          details.getAttribute("data-id") || "",
          String(details.open),
        );
      });
    });
  });
</script>
