---
import { match, Pattern } from "ts-pattern";

export type MenuItem = {
  title: string;
  path?: string;
  icon?: object;
};

interface Props extends MenuItem {}

const { title, path, icon } = Astro.props;
---

{
  match(path)
    .with(undefined, () => (
      <div class="menu-title font-normal text-base-content flex flex-row items-center gap-2">
        <slot name="icon" />
        {title}
      </div>
    ))
    .with(Pattern.string, () => (
      <a
        href={path}
        class:list={["font-bold", { active: path === Astro.url.pathname }]}
      >
        {title}
      </a>
    ))
    .exhaustive()
}
