---
import { match, Pattern } from "ts-pattern";
import { Name } from "./icons/Icon.astro";

export type MenuItem = {
  title: string;
  path?: string;
  icon?: Name | string;
};

type Props = MenuItem;

const { title, path, icon } = Astro.props;
---

{
  match(path)
    .with(undefined, () => (
      <div class="menu-title font-normal text-base-content flex flex-row items-center gap-2">
        <slot name="icon" />
        {title}
      </div>
    ))
    .with(Pattern.string, () => (
      <a
        class:list={[
          {
            active:
              path === Astro.url.pathname ||
              (path && Astro.url.pathname.includes(path)),
          },
          "font-semibold",
        ]}
        href={path}
        style="display: block;"
      >
        {icon && (
          <span slot="icon" class="[&>svg]:h-4 [&>svg]:w-4">
            <Fragment set:html={icon} />
          </span>
        )}
        <span>{title}</span>
      </a>
    ))
    .exhaustive()
}
