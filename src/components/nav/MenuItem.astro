---
import { match, Pattern } from "ts-pattern";
import { Name } from "./icons/Icon.astro";

export type MenuItem = {
  title: string;
  path?: string;
  icon?: Name | string;
};

type Props = MenuItem;

const { title, path } = Astro.props;
---

{
  match(path)
    .with(undefined, () => (
      <div class="menu-title font-normal text-base-content flex flex-row items-center gap-2">
        <slot name="icon" />
        {title}
      </div>
    ))
    .with(Pattern.string, () => (
      <a
        href={path}
        class:list={["font-semibold", { active: path === Astro.url.pathname }]}
      >
        {title}
      </a>
    ))
    .exhaustive()
}
