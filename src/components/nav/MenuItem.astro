---
import { match, Pattern } from "ts-pattern";
import { wildcardMatch } from "$utils/wildcardMatch";
import { Name } from "./icons/Icon.astro";
import LoadingWrapper from "./LoadingWrapper.svelte";
import type { TranscriptionType } from "$types/TranscribeRequest";

export type MenuItem = {
  title: string;
  path?: string;
  icon?: Name | string;
  usecaseId?: string;
  transcriptionType?: TranscriptionType;
  isFullPageReload?: boolean;
};

type Props = MenuItem;

const {
  title,
  path,
  icon,
  usecaseId,
  transcriptionType,
} = Astro.props;
---

{
  match(path)
    .with(undefined, () => (
      <div class="menu-title font-normal text-base-content flex flex-row items-center gap-2">
        <slot name="icon" />
        {title}
      </div>
    ))
    .with(Pattern.string, () => (
      <a
        class:list={[
          {
            "menu-active":
              path === Astro.url.pathname ||
              wildcardMatch(Astro.url.pathname, `${path}`),
          },
          "font-semibold flex justify-between w-full",
        ]}
        href={path}
      >
        {icon && (
          <span slot="icon" class="[&>svg]:h-4 [&>svg]:w-4">
            <Fragment set:html={icon} />
          </span>
        )}
        <span class="inline-block w-full truncate">{title}</span>
        {usecaseId && (
          <LoadingWrapper
            usecaseId={usecaseId}
            transcriptionType={transcriptionType}
            isSelected={
              path === Astro.url.pathname ||
              wildcardMatch(Astro.url.pathname, `${path}`)
            }
            client:load
          />
        )}
      </a>
    ))
    .exhaustive()
}
