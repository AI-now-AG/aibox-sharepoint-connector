---
import { POSTHOG_API_HOST } from "$types/Posthog";
const userId = Astro.locals?.user?.id?.toString() || "anonymous";
const userEmail = Astro.locals?.user?.email || "";

// Use environment-based key
const serialized = JSON.stringify({
  key: import.meta.env.PUBLIC_POSTHOG_KEY,
  apiHost: POSTHOG_API_HOST,
  userId,
  userEmail,
});
---

<script
  is:inline
  type="text/javascript"
  define:vars={{ serialized }}
  id="posthog-js"
>
  const POSTHOG_CONFIG = JSON.parse(serialized);
  //console.log("Initializing PostHog with config:", POSTHOG_CONFIG);

  // eslint-disable-next-line @typescript-eslint/no-unused-expressions
  !(function (t, e) {
    // eslint-disable-next-line no-var
    var o, n, p, r;
    // eslint-disable-next-line @typescript-eslint/no-unused-expressions
    e.__SV ||
      ((window.posthog = e),
      (e._i = []),
      (e.init = function (i, s, a) {
        function g(t, e) {
          // eslint-disable-next-line no-var
          var o = e.split(".");
          // eslint-disable-next-line @typescript-eslint/no-unused-expressions
          2 == o.length && ((t = t[o[0]]), (e = o[1])),
            (t[e] = function () {
              // eslint-disable-next-line prefer-rest-params
              t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
            });
        }
        // eslint-disable-next-line @typescript-eslint/no-unused-expressions
        ((p = t.createElement("script")).type = "text/javascript"),
          (p.crossOrigin = "anonymous"),
          (p.async = true),
          (p.src = s.api_host + "/static/array.js"),
          (r = t.getElementsByTagName("script")[0]).parentNode.insertBefore(
            p,
            r,
          );
        // eslint-disable-next-line no-var
        var u = e;
        // eslint-disable-next-line @typescript-eslint/no-unused-expressions
        void 0 !== a ? (u = e[a] = []) : (a = "posthog");
        u.people = u.people || [];
        u.toString = function (t) {
          // eslint-disable-next-line no-var
          var e = "posthog";
          return "posthog" !== a && (e += "." + a), t || (e += " (stub)"), e;
        };
        u.people.toString = function () {
          return u.toString(1) + ".people (stub)";
        };
        o =
          "capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(
            " ",
          );
        for (n = 0; n < o.length; n++) g(u, o[n]);
        e._i.push([i, s, a]);
      }),
      (e.__SV = 1));
  })(document, window.posthog || []);

  posthog.init(POSTHOG_CONFIG.key, {
    api_host: POSTHOG_CONFIG.apiHost,
    defaults: "2025-05-24",
    loaded: function (posthog) {
      posthog.identify(POSTHOG_CONFIG.userId, {
        email: POSTHOG_CONFIG.userEmail,
      });
    },
    opt_in_site_apps: true,
    // disable_session_recording: true // Off HERE
  });
</script>
