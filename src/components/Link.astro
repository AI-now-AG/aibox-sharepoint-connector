---
interface Props {
  text: string;
  href: string;
  style: "primary" | "secondary";
  icon?: {
    name: string;
    side: "left" | "right";
  };
  filled?: boolean;
  borderVisible?: boolean;
  classes: string;
}

const {
  text,
  href,
  style,
  icon,
  filled = false,
  borderVisible = false,
  classes,
  ...rest
} = Astro.props as Props;
---

<a
  href={href}
  class:list={[
    "link",
    classes,
    style,
    { filled: filled, bordered: borderVisible },
  ]}
  {...rest}
>
  {icon && icon.side == "left" && <img src={icon.name} />}

  <span>{text}</span>

  {icon && icon.side == "right" && <img src={icon.name} />}
</a>
