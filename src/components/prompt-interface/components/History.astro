---
import PromptDetails from "./PromptDetails.svelte";
---

<div role="tablist" class="w-full tabs">
  <input
    type="radio"
    name="my_tabs_1"
    role="tab"
    class="tab checked:font-bold"
    aria-label="Settings"
    checked="checked"
  />
  <div role="tabpanel" class="tab-content w-full">
    <div class="divider"></div>
    <div class="px-2">
      <PromptDetails preferredLocale={Astro.preferredLocale} client:load />
    </div>
  </div>
</div>
