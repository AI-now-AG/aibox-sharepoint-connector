---
import InputArea from "./Input.svelte";
---

<div
  class="grid grid-cols-1 grid-rows-[1fr_min-content] h-full max-w-4xl mx-auto"
>
  <div class="flex flex-col gap-8">
    <h1 class="pt-2 lg:pt-8 text-4xl font-bold">
      Hello User, let's write some headlines
    </h1>
    <p class="">
      Get started with predefined prompt below or provide me your own.
    </p>
    <div
      class="grid grid-cols-2 sm:grid-cols-3 lg:flex lg:flex-row lg:flex-wrap gap-4"
    >
      <button
        class="btn btn-primary btn-active lg:w-48 h-auto py-4 px-2 leading-6"
      >
        <!-- Active variant -->
        Summarize the main points of a pdf
      </button>
      <button class="btn bg-base-100 lg:w-48 h-auto py-4 px-4 leading-6"
        >List the key points from a text</button
      >
      <button class="btn bg-base-100 lg:w-48 h-auto py-4 px-4 leading-6"
        >Summarize the text with an academic focus</button
      >
    </div>
  </div>

  <InputArea client:load />
</div>
