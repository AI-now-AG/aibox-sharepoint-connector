---
import ContentHeader from "./ContentHeader.svelte";
import PromptExecution from "./PromptExecution.svelte";
import EmptyPrompt from "./EmptyPrompt.svelte";
import { Permission } from "$types/Users";

export interface Props {
  categoryId: string;
  groupId: string;
  useCaseTitle: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  promptItems: any;
}
const { categoryId, groupId, useCaseTitle, promptItems = [] } = Astro.props;
const userPermissions = Astro.locals.user.permissions;
const isEditable = userPermissions.includes(Permission.AdminAll);

const promptId = Astro.url?.searchParams?.get?.("promptId") ?? "";
---

<div class="container max-w-6xl mx-auto grid grid-cols-1 px-14">
  <ContentHeader
    title={useCaseTitle}
    currentCategoryId={categoryId}
    currentGroupId={groupId}
    isEditable={isEditable && promptItems.length > 0}
    client:load
  />

  {
    promptItems.length > 0 ? (
      <PromptExecution
        promptItems={promptItems}
        isEditable={
          userPermissions.includes(Permission.AdminAll) ||
          userPermissions.includes(Permission.SuperUserAll)
        }
        groupId={groupId}
        folderName={Astro.locals.tenant.org_name}
        initSelectedPromptId={promptId}
        client:load
      />
    ) : (
      <EmptyPrompt
        currentCategoryId={categoryId}
        currentGroupId={groupId}
        {isEditable}
        client:load
      />
    )
  }
</div>
