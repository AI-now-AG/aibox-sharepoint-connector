---
import ContentHeader from "./ContentHeader.svelte";
import PromptExecution from "./PromptExecution.svelte";
import EmptyPrompt from "./EmptyPrompt.svelte";
import { FeaturePermission } from "$types/Users";
import { isFeaturePermissionEnabled } from "$utils/permission";

export interface Props {
  categoryId: string;
  groupId: string;
  useCaseTitle: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  promptItems: any;
}
const { categoryId, groupId, useCaseTitle, promptItems = [] } = Astro.props;
const userPermissions = Astro.locals.user.permissions;
const isAddable = isFeaturePermissionEnabled(
  FeaturePermission.AddAssistantInPromptExecutionArea,
  userPermissions
);
const isEditable = isFeaturePermissionEnabled(
  FeaturePermission.EditAssistantInPromptExecutionArea,
  userPermissions
);

const promptId = Astro.url?.searchParams?.get?.("promptId") ?? "";
---

<div class="container max-w-6xl mx-auto grid grid-cols-1 px-4 lg:px-14 overflow-x-hidden">
  <ContentHeader
    title={useCaseTitle}
    currentCategoryId={categoryId}
    currentGroupId={groupId}
    isEditable={isAddable && promptItems.length > 0}
    client:load
  />

  {
    promptItems.length > 0 ? (
      <PromptExecution
        promptItems={promptItems}
        {isEditable}
        groupId={groupId}
        folderName={Astro.locals.tenant.org_name}
        initSelectedPromptId={promptId}
        client:load
      />
    ) : (
      <EmptyPrompt
        currentCategoryId={categoryId}
        currentGroupId={groupId}
        {isEditable}
        client:load
      />
    )
  }
</div>
