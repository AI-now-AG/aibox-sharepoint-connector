---
import InitializeTheme from "$components/theme/InitializeTheme.astro";
import InitializeColor from "$components/theme/InitializeColor.astro";
import SharedVariables from "$components/theme/SharedVariables.svelte";
import Toasts from "$components/toast-notification/Toasts.svelte";
import { useTranslations } from "$i18n/utils";

const t = useTranslations();

const user = Astro.locals.user;
const primaryColor = Astro.locals.tenant?.primary_color;
---

<style is:global>
  /* TODO: Workaround for the demo. The logo has to be part of the theme. */
  .logo-somedia {
    display: none;
  }
  [data-theme="somedia"] .logo-somedia {
    display: block;
  }
  [data-theme="somedia"] .logo-light,
  [data-theme="somedia"] .logo-dark {
    display: none;
  }
  [data-theme="dark"] .logo-light,
  [data-theme="luxury"] .logo-light {
    display: none;
  }
  [data-theme="light"] .logo-dark,
  [data-theme="lemonade"] .logo-dark {
    display: none;
  }
</style>

<!-- Set default theme -->
<InitializeTheme />

<!-- Set primary color -->
{primaryColor && <InitializeColor />}

<!-- Shared variables for all .svelte components -->
<SharedVariables
  tenant={Astro.locals.tenant}
  user={Astro.locals.user}
  locale={Astro.locals.locale}
  client:load
/>

<header class="container-fluid mx-auto navbar bg-base-200">
  <div class="navbar-start">
    <div class="lg:hidden">
      <label
        for="left-drawer-trigger"
        aria-label="open sidebar"
        class="btn btn-square btn-ghost"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h8m-8 6h16"></path>
        </svg>
      </label>
    </div>
    <div class="lg:hidden pl-2">
      <a href="/">
        <img
          src="/soki-somedia.png"
          alt="Somedia Logo"
          class="h-8 logo-somedia"
        />
        <!-- light/dark mode doesn't work currently in the way themes are implemented. Currently only the light variant will be rendered -->
        <img
          src="/aibox-logo-text.svg"
          class="logo-light h-8 w-auto dark:hidden"
        />
        <img src="/aibox-logo-text-dark.svg" class="logo-dark h-8 dark:block" />
      </a>
    </div>
  </div>
  <div class="navbar-end">
    <div class="dropdown dropdown-end">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
        <div class="w-10 rounded-full">
          <img alt="Avatar Image" src={user.picture} />
        </div>
      </div>
      <ul
        tabindex="0"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-10 mt-3 w-52 p-2 shadow border"
      >
        <li>
          <a class="justify-between">
            Profile
            <span class="badge">New</span>
          </a>
        </li>
        <li><a>Settings</a></li>
        <li id="logout"><a href="/api/logout" data-astro-reload>Logout</a></li>
      </ul>
    </div>
  </div>
</header>

<Toasts client:load />
