---
import InitializeTheme from "$components/theme/InitializeTheme.astro";
import InitializeColor from "$components/theme/InitializeColor.astro";
import SharedVariables from "$components/theme/SharedVariables.svelte";
import Toasts from "$components/toast-notification/Toasts.svelte";
import { transformRawData } from "$utils/transformRawData";
import { svgIcons } from "$assets/icons";
import { useTranslations } from "$i18n/utils";

const user = Astro.locals.user;
const primaryColor = Astro.locals.tenant?.primary_color;
const t = useTranslations();
---

<!-- Set default theme -->
<InitializeTheme />

<!-- Set primary color -->
{primaryColor && <InitializeColor />}

<!-- Shared variables for all .svelte components -->
<SharedVariables
  tenant={transformRawData(Astro.locals.tenant)}
  user={transformRawData(Astro.locals.user)}
  locale={Astro.locals.locale}
  client:load
/>

<header class="container-fluid mx-auto navbar bg-base-200">
  <div class="navbar-start">
    <div class="lg:hidden">
      <label
        for="left-drawer-trigger"
        aria-label="open sidebar"
        class="btn btn-square btn-ghost"
      >
        <span set:html={svgIcons.hamburger} />
      </label>
    </div>
    <div class="lg:hidden pl-2">
      <a href="/">
        <img
          src="/logo-aibox-christmasedition.svg"
          alt="Weihnachtsmann Logo"
          class="h-8 hidden [[data-theme=weihnachtsmann]_&]:block"
        />
        <img
          src="/soki-somedia.png"
          alt="Somedia Logo"
          class="h-8 hidden [[data-theme=somedia]_&]:block"
        />
        <img
          src="/aibox-logo-text.svg"
          alt="light Logo"
          class="logo-light h-8 w-auto hidden [[data-theme=light]_&]:block"
        />
        <img
          src="/aibox-logo-text-dark.svg"
          alt="dark Logo"
          class="logo-dark h-8 hidden [[data-theme=dark]_&]:block"
        />
      </a>
    </div>
  </div>
  <div class="navbar-end">
    <div class="dropdown dropdown-end z-30">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
        <div class="w-8 rounded-full">
          <span set:html={svgIcons.questionMark} style="color:#4a20ff;" />
        </div>
      </div>
      <ul
        tabindex="0"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-10 mt-3 w-52 p-2 shadow border"
      >
        <li>
          <a
            class="justify-between"
            href="https://ainow.ch/aibox/how-to"
            target="_blank"
          >
            {t("guideline.aibox-how-to")}
          </a>
        </li>
        <li>
          <a
            class="justify-between"
            href="https://ainow.ch/aibox/support"
            target="_blank"
          >
            {t("guideline.support")}
          </a>
        </li>
      </ul>
    </div>

    <div class="dropdown dropdown-end z-30">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
        <div class="w-10 rounded-full">
          <img alt="Avatar Image" src={user.picture} />
        </div>
      </div>
      <ul
        tabindex="0"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-10 mt-3 w-52 p-2 shadow border"
      >
        <li>
          <a class="justify-between" href="/profile">{t("profile")}</a>
        </li>
        <li id="logout">
          <button onclick="window.location.href='/api/logout'"
            >{t("logout")}</button
          >
        </li>
      </ul>
    </div>
  </div>
</header>

<Toasts client:load />
