---
import InitializeTheme from "$components/theme/InitializeTheme.astro";
import SharedVariables from "$components/theme/SharedVariables.svelte";
import Toasts from "$components/toast-notification/Toasts.svelte";
import { transformRawData } from "$utils/transformRawData";
import { svgIcons } from "$assets/icons";
import { useTranslations } from "$i18n/utils";

const user = Astro.locals.user;
const t = useTranslations();
---

<!-- Set default theme -->
<InitializeTheme />

<!-- Shared variables for all .svelte components -->
<SharedVariables
  tenant={transformRawData(Astro.locals.tenant)}
  user={transformRawData(Astro.locals.user)}
  locale={Astro.locals.locale}
  client:load
/>

<header class="container-fluid mx-auto navbar bg-base-200">
  <div class="navbar-start">
    <div class="lg:hidden">
      <label
        for="left-drawer-trigger"
        aria-label="open sidebar"
        class="btn btn-square btn-ghost"
      >
        <span set:html={svgIcons.hamburger} />
      </label>
    </div>
    <div class="lg:hidden pl-2">
      <a href="/">
        <img
          src="/aibox-logo-text.svg"
          alt="Aibox Default Logo"
          class="h-8 block in-data-[theme=weihnachtsmann]:hidden in-data-[theme=somedia]:hidden in-data-[theme=light]:hidden in-data-[theme=dark]:hidden"
        />

        <img
          src="/logo-aibox-christmasedition.svg"
          alt="Weihnachtsmann Logo"
          class="h-8 hidden in-data-[theme=weihnachtsmann]:block"
        />
        <img
          src="/soki-somedia.png"
          alt="Somedia Logo"
          class="h-8 hidden in-data-[theme=somedia]:block"
        />
        <img
          src="/aibox-logo-text.svg"
          alt="light Logo"
          class="logo-light h-8 w-auto hidden in-data-[theme=light]:block"
        />
        <img
          src="/aibox-logo-text-dark.svg"
          alt="dark Logo"
          class="logo-dark h-8 hidden in-data-[theme=dark]:block"
        />
      </a>
    </div>
  </div>
  <div class="navbar-end">
    <div class="z-30 mr-2">
      <a
        class="btn btn-ghost btn-circle"
        href="https://support.aibox-app.ch/"
        target="_blank"
      >
        <div
          class="flex items-center justify-center w-8 h-8 rounded-full border-3 border-indigo-600 tooltip tooltip-bottom"
          data-tip={t("common.support")}
        >
          <p class="text-lg text-indigo-600">?</p>
        </div>
      </a>
    </div>

    <div class="dropdown dropdown-end z-30">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
        <div class="w-10 rounded-full">
          <img alt="Avatar Image" src={user.picture} />
        </div>
      </div>
      <ul
        tabindex="0"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-10 mt-3 w-52 p-2 shadow-sm border"
      >
        <li>
          <a class="justify-between" href="/profile">{t("profile")}</a>
        </li>
        <li id="logout">
          <button onclick="window.location.href='/api/logout'"
            >{t("common.logout")}</button
          >
        </li>
      </ul>
    </div>
  </div>
</header>

<Toasts client:load />
