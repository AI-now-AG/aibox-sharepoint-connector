---
import Header from "$components/Header.astro";
import Footer from "$components/Footer.astro";
import Head from "./Head.astro";
import Navigation from "$components/nav/Navigation.astro";
import OnboardingTour from "$components/OnboardingTour.svelte";
import TrialComponent from "$components/TrialComponent.svelte";
import RestrictUnverifiedUser from "$components/RestrictUnverifiedUser.svelte";
import "$styles/global.css";

import { useTranslations } from "$i18n/utils";
import { isSocialConnection } from "$utils/common";

interface Props {
  title?: string;
  description?: string;
  isFooterVisible?: boolean;
}

const t = useTranslations();

const {
  title = t("site.title"),
  description = t("site.description"),
  isFooterVisible = false,
} = Astro.props;

// TODO: save theme settings in db
let theme = "light";

switch (Astro.locals.user?.tenant_id?.toString()) {
  case "66aa21a3d40d0b194e280143":
    theme = "somedia";
    break;
  case "674347ba64f450769a147f6a":
    theme = "weihnachtsmann";
    break;
  default:
    theme = "light";
}

const { user, tenant, locale } = Astro.locals;
const userInfo = { ...user, id: user.id.toString() };
const isSocialAuth = isSocialConnection(userInfo?.auth0_sub);
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <Head {title} {description} />
  <body class="min-h-screen grid grid-rows-[min-content_1fr]">
    <div class="drawer lg:drawer-open">
      <input id="left-drawer-trigger" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content grid grid-rows-[1fr_min-content]">
        <main
          class="min-w-xs min-h-screen flex w-full flex-col lg:basis-2/3 bg-base-200"
        >
          <Header />
          <slot />
        </main>
        {isFooterVisible && <Footer />}
      </div>
      <div class="drawer-side z-20 lg:h-auto z-50">
        <label
          for="left-drawer-trigger"
          aria-label="close sidebar"
          class="drawer-overlay"></label>

        <Navigation />
      </div>
    </div>
    {tenant?.is_trial && <OnboardingTour user={userInfo} client:load />}
    {tenant?.is_trial && <TrialComponent {locale} client:load />}
    {
      tenant?.is_trial &&
        !isSocialAuth &&
        user?.email_verified != undefined &&
        !user.email_verified && (
          <RestrictUnverifiedUser user={userInfo} client:load />
        )
    }
  </body>
</html>
