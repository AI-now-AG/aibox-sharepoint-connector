---
import Header from "$components/Header.astro";
import Footer from "$components/Footer.astro";
import Head from "./Head.astro";
import Navigation from "$components/nav/Navigation.astro";

import "$styles/global.css";

import { useTranslations } from "$i18n/utils";

interface Props {
  title?: string;
  description?: string;
  isFooterVisible?: boolean;
}

const t = useTranslations(Astro.preferredLocale);

const {
  title = t("site.title"),
  description = t("site.description"),
  isFooterVisible = false,
} = Astro.props;

// TODO: save theme settings in db
const theme =
  Astro.locals.user.tenant_id.toString() === "66aa21a3d40d0b194e280143"
    ? "somedia"
    : "light";
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <Head {title} {description} />
  <body class="min-h-screen grid grid-rows-[min-content_1fr]">
    <Header />
    <div class="drawer lg:drawer-open">
      <input id="left-drawer-trigger" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content grid grid-rows-[1fr_min-content]">
        <main
          class="min-w-xs flex w-full flex-col lg:basis-2/3 bg-base-200 border-t border-l border-base-content/10"
        >
          <slot />
        </main>
        {isFooterVisible && <Footer />}
      </div>
      <div class="drawer-side top-16 z-20 lg:h-auto">
        <label
          for="left-drawer-trigger"
          aria-label="close sidebar"
          class="drawer-overlay"></label>
        <Navigation />
      </div>
    </div>
  </body>
</html>
