---
const { title } = Astro.props;
import { svgIcons } from "$assets/icons";
import SubsciptionSteps from "$components/subscription/SubsciptionSteps.svelte";

let currentStep = 0;
const pathname = Astro.url.pathname;
switch (pathname) {
  case "/subscription/step1":
    currentStep = 0;
    break;
  case "/subscription/step2":
    currentStep = 1;
    break;
  case "/subscription/step3":
    currentStep = 2;
    break;
  case "/subscription/step4":
    currentStep = 3;
    break;
  case "/subscription/complete":
    currentStep = 4;
    break;
  default:
    currentStep = -1;
}
---

<!doctype html>
<html lang="en" data-theme="mytheme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      @import "../styles/global.css";
      html {
        background-color: white;
      }
    </style>
  </head>
  <body class="flex min-h-screen bg-white">
    <!-- Left Sidebar -->
    <aside
      class="flex-1 bg-[#491EFF] text-white flex flex-col items-center relative"
    >
      <div
        class="w-full h-auto flex justify-center items-center absolute top-[60px] left-0 z-[1]"
      >
        <img src="/sidebar_background.png" />
      </div>
      <div class="w-auto self-start ml-4 mt-2">
        <span set:html={svgIcons.logo} />
      </div>

      <div class="flex flex-1 justify-center items-center z-[2]">
        {
          currentStep !== -1 && (
            <div class="mt-[-20px]">
              <SubsciptionSteps {currentStep} />
            </div>
          )
        }
      </div>
    </aside>

    <!-- Right Content Section -->
    <main class="flex-3 p-8">
      <slot />
    </main>
  </body>
</html>
