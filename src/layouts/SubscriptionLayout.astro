---
const { title } = Astro.props;
import SubsciptionSteps from "$components/subscription/SubsciptionSteps.svelte";
---

<!DOCTYPE html>
<html lang="en" data-theme="mytheme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body class="flex min-h-screen bg-gray-100">
    <!-- Left Sidebar -->
    <aside class="w-80 bg-[#491EFF] text-white p-6 flex flex-col items-center">
      <div class="text-2xl font-bold mb-8 text-white">aibox</div>
     <SubsciptionSteps currentStep={2} />
    </aside>

    <!-- Right Content Section -->
    <main class="flex-1 p-8">
      <slot />
    </main>
  </body>
</html>