---
import { svgIcons } from "$assets/icons";
import PostHogJs from "$components/PostHogJs.astro";
import Toasts from "$components/toast-notification/Toasts.svelte";
import SubsciptionSteps from "$components/subscription/SubsciptionSteps.svelte";
import { SubscriptionStep } from "$types/Subscription";

let currentStep = 0;
const pathname = Astro.url.pathname;
switch (pathname) {
  case "/subscription/step1":
    currentStep = SubscriptionStep.Step1;
    break;
  case "/subscription/step2":
    currentStep = SubscriptionStep.Step2;
    break;
  case "/subscription/step3":
    currentStep = SubscriptionStep.Step3;
    break;
  case "/subscription/step4":
    currentStep = SubscriptionStep.Step4;
    break;
  case "/subscription/complete":
    currentStep = SubscriptionStep.Completed;
    break;
  default:
    currentStep = -1;
}

const { title, description } = Astro.props;

// TODO: save theme settings in db
const theme = Astro.locals?.tenant?.theme || "light";
const defaultLanguage = Astro.locals?.tenant?.default_language || "en";

const { tenant } = Astro.locals;
const isPosthogEnabled = tenant && tenant.is_on_posthog;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="descrption" content={description} />

    <link rel="icon" href="/favicon.svg" />

    <style is:global>
      @import "../styles/global.css";
      html,
      body {
        background-color: rgb(250, 250, 250);
      }
    </style>

    {isPosthogEnabled && <PostHogJs />}
  </head>
  <body class="flex min-h-screen">
    <!-- Left Sidebar -->
    <aside
      class="w-[0px] md:w-[360px] lg:w-[360px] bg-primary hidden md:flex lg:flex text-white flex flex-col items-center relative"
    >
      <div
        class="w-full h-auto flex justify-center items-center absolute top-[60px] left-0 z-[1]"
      >
        <img src="/sidebar_background.png" class="w-full" />
      </div>
      <a href="/" class="w-auto self-start ml-4 mt-2 fixed z-[2]">
        <span set:html={svgIcons.logo} />
      </a>

      <div class="flex flex-1 justify-center mt-[60px] fixed z-[2]">
        {
          currentStep !== -1 && (
            <div class="p-6">
              <SubsciptionSteps
                orientation="vertical"
                {currentStep}
                {defaultLanguage}
                client:load
              />
            </div>
          )
        }
      </div>
    </aside>

    <!-- Right Content Section -->
    <main class="flex-1 p-8">
      <slot />
    </main>

    <Toasts client:load />
  </body>
</html>
