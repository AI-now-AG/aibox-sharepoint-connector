---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="mytheme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body class="flex min-h-screen bg-gray-100">
    <!-- Left Sidebar -->
    <aside class="w-64 bg-[#1E3A8A] text-white p-6 flex flex-col items-center">
      <div class="text-2xl font-bold mb-8 text-white">aibox</div>
      <ul class="steps steps-vertical text-white">
        <li class="step step-primary">Choose your plan</li>
        <li class="step">Provide your billing data</li>
        <li class="step">Customize your aibox</li>
        <li class="step">Create your aibox organization</li>
      </ul>
    </aside>

    <!-- Right Content Section -->
    <main class="flex-1 p-8">
      <slot />
    </main>
  </body>
</html>