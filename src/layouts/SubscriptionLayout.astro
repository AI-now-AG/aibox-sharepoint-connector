---
import { svgIcons } from "$assets/icons";
import SubsciptionSteps from "$components/subscription/SubsciptionSteps.svelte";
import { SUBSCIPTION_STEP } from "$constants";

let currentStep = 0;
const pathname = Astro.url.pathname;
switch (pathname) {
  case "/subscription/step1":
    currentStep = SUBSCIPTION_STEP.Step1;
    break;
  case "/subscription/step2":
    currentStep = SUBSCIPTION_STEP.Step2;
    break;
  case "/subscription/step3":
    currentStep = SUBSCIPTION_STEP.Step3;
    break;
  case "/subscription/step4":
    currentStep = SUBSCIPTION_STEP.Step4;
    break;
  case "/subscription/complete":
    currentStep = SUBSCIPTION_STEP.Completed;
    break;
  default:
    currentStep = -1;
}

const { title, description } = Astro.props;

// TODO: save theme settings in db
let theme = "light";

switch (Astro.locals.user?.tenant_id?.toString()) {
  case "66aa21a3d40d0b194e280143":
    theme = "somedia";
    break;
  case "674347ba64f450769a147f6a":
    theme = "weihnachtsmann";
    break;
  default:
    theme = "light";
}
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="descrption" content={description} />

    <link rel="icon" href="/favicon.svg" />

    <style is:global>
      @import "../styles/global.css";
      html,
      body {
        background-color: rgb(250, 250, 250);
      }
    </style>
  </head>
  <body class="flex min-h-screen">
    <!-- Left Sidebar -->
    <aside
      class="w-[360px] bg-[#491EFF] text-white flex flex-col items-center relative"
    >
      <div
        class="w-full h-auto flex justify-center items-center absolute top-[60px] left-0 z-[1]"
      >
        <img src="/sidebar_background.png" class="w-full" />
      </div>
      <div class="w-auto self-start ml-4 mt-2">
        <span set:html={svgIcons.logo} />
      </div>

      <div class="flex flex-1 justify-center z-[2]">
        {
          currentStep !== -1 && (
            <div class="p-6">
              <SubsciptionSteps {currentStep} />
            </div>
          )
        }
      </div>
    </aside>

    <!-- Right Content Section -->
    <main class="flex-1 p-8">
      <slot />
    </main>
  </body>
</html>
