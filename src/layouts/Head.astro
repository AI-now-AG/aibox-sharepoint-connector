---
import { ClientRouter } from "astro:transitions";
import PostHog from "$components/posthog.astro";

const { title, description } = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="descrption" content={description} />

  <link rel="icon" href="/favicon.svg" />

  <PostHog />

  <ClientRouter />

  <link
    rel="stylesheet"
    href="https://fonts.upset.dev/css2?family=Inter:wght@100..900&display=swap"
  />
  <script is:inline>
    /* We set the theme in a render blocking script tag early to avoid flashing */
    document.addEventListener("astro:page-load", function () {
      const theme = localStorage.getItem("theme");
      if (theme) {
        document.documentElement.setAttribute("data-theme", theme);
      }
    });

    // Keep original fetch reference
    const originalFetch = window.fetch;

    // Override fetch to handle 401 redirects
    window.fetch = async (...args) => {
      // eslint-disable-next-line @typescript-eslint/no-unused-vars
      const [input, init] = args;
      const url = typeof input === "string" ? input : input.url;

      if (url.includes("posthog.com")) {
        return originalFetch(...args);
      }

      const response = await originalFetch(...args);
      console.log(`[aibox] Wrapped fetch request: ${url}`);

      // Only act on same-origin requests
      const isSameOrigin =
        url.startsWith(window.location.origin) || !url.startsWith("http");

      if (isSameOrigin && response.status === 401) {
        console.warn(
          "Session expired or unauthorized. Redirecting to login...",
        );
        window.location.href = "/login/auth0";
        return new Response(null, { status: 401 });
      }
      return response;
    };
  </script>
</head>
