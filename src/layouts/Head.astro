---
import { ViewTransitions } from "astro:transitions";
const { title, description } = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="descrption" content={description} />

  <link rel="icon" href="/favicon.svg" />

  <ViewTransitions />

  <link
    rel="stylesheet"
    href="https://fonts.upset.dev/css2?family=Inter:wght@100..900&display=swap"
  />
  <script is:inline>
    /* We set the theme in a render blocking script tag early to avoid flashing */
    function setTheme() {
      const theme = localStorage.getItem("theme");
      if (theme) {
        document.documentElement.setAttribute("data-theme", theme);
      }
    }

    setTheme();
    document.addEventListener("astro:page-load", setTheme);
  </script>
</head>
