---
import { ClientRouter } from "astro:transitions";
const { title, description } = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="descrption" content={description} />

  <link rel="icon" href="/favicon.svg" />

  <ClientRouter />

  <link
    rel="stylesheet"
    href="https://fonts.upset.dev/css2?family=Inter:wght@100..900&display=swap"
  />
  <script is:inline>
    /* We set the theme in a render blocking script tag early to avoid flashing */
    document.addEventListener("astro:page-load", function () {
      const theme = localStorage.getItem("theme");
      if (theme) {
        document.documentElement.setAttribute("data-theme", theme);
      }
    });

    // Keep original fetch reference
    const originalFetch = window.fetch;

    // Override fetch to handle 401 redirects
    window.fetch = async (...args) => {
      const response = await originalFetch(...args);
      console.log("Wrapped fetch request", args);
      if (response.status === 401) {
        window.location.href = "/login/auth0";
        return new Response(null, { status: 401 });
      }
      return response;
    };
  </script>
</head>
