---
import { transformRawData } from "$utils/transformRawData";
import { pickUser, pickTenant } from "$utils/viewModels";
import PostHogJs from "$components/PostHogJs.astro";
import SharedVariables from "$components/theme/SharedVariables.svelte";
import Toasts from "$components/toast-notification/Toasts.svelte";

interface Props {
  title?: string;
}

const { title = "Self-Onboarding" } = Astro.props;

const theme = Astro.locals?.tenant?.theme || "light";
const defaultLanguage = Astro.locals?.tenant?.default_language || "en";

const { tenant } = Astro.locals;
const isPosthogEnabled = tenant && tenant.is_on_posthog;
---

<!doctype html>
<html lang={defaultLanguage} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={title} />
    <link rel="icon" href="/favicon.svg" />

    <style is:global>
      @import "../styles/global.css";
      html,
      body {
        min-height: 100vh;
      }
    </style>

    {isPosthogEnabled && <PostHogJs />}
  </head>

  <body
    class="min-h-screen flex items-center justify-center p-6"
    style="background-color: #491EFF;"
  >
    <!-- Shared variables for all Svelte components -->
    <!-- Initialize app locale for useTranslations() -->
    <SharedVariables
      tenant={transformRawData(pickTenant(Astro.locals.tenant))}
      user={transformRawData(pickUser(Astro.locals.user))}
      locale={Astro.locals.locale}
      client:load
    />
    <slot />
    <Toasts client:load />
  </body>
</html>
